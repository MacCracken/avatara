# avatara.tcyr -- Integration tests for avatara
#
# Cross-tradition invariants, registry completeness, compose correctness,
# history module, breath monotonicity, duplicate detection.

# Stdlib auto-included via cyrius.toml

include "src/types.cyr"
include "src/aspect.cyr"
include "src/error.cyr"
include "src/kabbalah.cyr"
include "src/angelic.cyr"
include "src/hindu.cyr"
include "src/olympian.cyr"
include "src/norse.cyr"
include "src/egyptian.cyr"
include "src/buddhist.cyr"
include "src/mesopotamian.cyr"
include "src/celtic.cyr"
include "src/shinto.cyr"
include "src/aztec.cyr"
include "src/maya.cyr"
include "src/yoruba.cyr"
include "src/zoroastrian.cyr"
include "src/taoist.cyr"
include "src/polynesian.cyr"
include "src/slavic.cyr"
include "src/jain.cyr"
include "src/sikh.cyr"
include "src/incarnate.cyr"
include "src/finnish.cyr"
include "src/vodou.cyr"
include "src/solar.cyr"
include "src/canaanite.cyr"
include "src/etruscan.cyr"
include "src/tarot.cyr"
include "src/iching.cyr"
include "src/inuit.cyr"
include "src/lakota.cyr"
include "src/haudenosaunee.cyr"
include "src/anishinaabe.cyr"
include "src/aboriginal.cyr"
include "src/compose.cyr"
include "src/history.cyr"
include "src/registry.cyr"
include "src/affinity.cyr"
include "src/shadow.cyr"
include "src/logging.cyr"

fn main() {
    alloc_init();

    # ================================================================
    # Struct layout: Profile_* (#derive) accessors map to ProfLayout
    # offsets, and sizeof == 320. Guards the manual-offset/struct match.
    # ================================================================
    assert_eq(PROF_SIZE, 320, "profile size 320");
    var lp = alloc(PROF_SIZE);
    Profile_set_warmth(lp, 42);
    assert_eq(load64(lp + PROF_WARMTH), 42, "Profile_set_warmth -> offset 24");
    Profile_set_spirit(lp, 176);
    assert_eq(load64(lp + PROF_SPIRIT), 176, "Profile_set_spirit -> offset 176 (emphasis)");
    Profile_set_domain(lp, 7);
    assert_eq(load64(lp + PROF_DOMAIN), 7, "Profile_set_domain -> offset 312");
    store64(lp + PROF_TIER, 5);
    assert_eq(Profile_tier(lp), 5, "Profile_tier reads offset 288");

    # ================================================================
    # Total entity count
    # ================================================================
    var profiles = all_profiles();
    var count = vec_len(profiles);
    assert_gte(count, 250, "total entity count >= 250");

    # ================================================================
    # All profiles have non-empty name, tradition, description, soul, spirit
    # ================================================================
    var text_ok = 1;
    for (var i = 0; i < count; i = i + 1) {
        var p = vec_get(profiles, i);
        if (prof_name(p) == 0) { text_ok = 0; }
        if (prof_tradition(p) == 0) { text_ok = 0; }
        if (prof_desc(p) == 0) { text_ok = 0; }
        if (prof_soul(p) == 0) { text_ok = 0; }
        if (prof_spirit(p) == 0) { text_ok = 0; }
    }
    assert_eq(text_ok, 1, "all profiles have name/tradition/desc/soul/spirit");

    # ================================================================
    # All trait weights in 0.0-1.0
    # ================================================================
    var traits_ok = 1;
    for (var i = 0; i < count; i = i + 1) {
        var p = vec_get(profiles, i);
        var off = TW_FIRST;
        while (off <= TW_LAST) {
            var v = load64(p + off);
            if (f64_lt(v, 0.0) == 1) { traits_ok = 0; }
            if (f64_gt(v, 1.0) == 1) { traits_ok = 0; }
            off = off + 8;
        }
    }
    assert_eq(traits_ok, 1, "all trait weights in 0.0-1.0");

    # ================================================================
    # All module emphases in 0.0-1.0
    # ================================================================
    var emph_ok = 1;
    for (var i = 0; i < count; i = i + 1) {
        var p = vec_get(profiles, i);
        var off = ME_FIRST;
        while (off <= ME_LAST) {
            var v = load64(p + off);
            if (f64_lt(v, 0.0) == 1) { emph_ok = 0; }
            if (f64_gt(v, 1.0) == 1) { emph_ok = 0; }
            off = off + 8;
        }
    }
    assert_eq(emph_ok, 1, "all module emphases in 0.0-1.0");

    # ================================================================
    # No duplicate names within a tradition
    # ================================================================
    var dup_ok = 1;
    for (var i = 0; i < count; i = i + 1) {
        var p1 = vec_get(profiles, i);
        for (var j = i + 1; j < count; j = j + 1) {
            var p2 = vec_get(profiles, j);
            if (streq(prof_tradition(p1), prof_tradition(p2)) == 1) {
                if (streq(prof_name(p1), prof_name(p2)) == 1) {
                    dup_ok = 0;
                }
            }
        }
    }
    assert_eq(dup_ok, 1, "no duplicate names within tradition");

    # ================================================================
    # Breath intensity monotonic: exhale increases, inhale decreases
    # ================================================================
    assert_eq(f64_lt(breath_intensity(BREATH_UNITY), breath_intensity(BREATH_EARLY_EXHALE)), 1, "unity < early_exhale");
    assert_eq(f64_lt(breath_intensity(BREATH_EARLY_EXHALE), breath_intensity(BREATH_MID_EXHALE)), 1, "early_exhale < mid_exhale");
    assert_eq(f64_lt(breath_intensity(BREATH_MID_EXHALE), breath_intensity(BREATH_LATE_EXHALE)), 1, "mid_exhale < late_exhale");
    assert_eq(f64_gt(breath_intensity(BREATH_LATE_EXHALE), breath_intensity(BREATH_EARLY_INHALE)), 1, "late_exhale > early_inhale");
    assert_eq(f64_gt(breath_intensity(BREATH_EARLY_INHALE), breath_intensity(BREATH_MID_INHALE)), 1, "early_inhale > mid_inhale");
    assert_eq(f64_gt(breath_intensity(BREATH_MID_INHALE), breath_intensity(BREATH_LATE_INHALE)), 1, "mid_inhale > late_inhale");

    # ================================================================
    # Traditions cover expected set
    # ================================================================
    var trads = all_traditions();
    var found_kabbalah = 0;
    var found_hindu = 0;
    var found_norse = 0;
    var found_greek = 0;
    var found_aztec = 0;
    var found_jain = 0;
    var found_sikh = 0;
    var found_polynesian = 0;
    var found_slavic = 0;
    for (var i = 0; i < vec_len(trads); i = i + 1) {
        var t = vec_get(trads, i);
        if (streq(t, "Kabbalah") == 1) { found_kabbalah = 1; }
        if (streq(t, "Hindu") == 1) { found_hindu = 1; }
        if (streq(t, "Norse") == 1) { found_norse = 1; }
        if (streq(t, "Greek") == 1) { found_greek = 1; }
        if (streq(t, "Aztec") == 1) { found_aztec = 1; }
        if (streq(t, "Jain") == 1) { found_jain = 1; }
        if (streq(t, "Sikh") == 1) { found_sikh = 1; }
        if (streq(t, "Polynesian") == 1) { found_polynesian = 1; }
        if (streq(t, "Slavic") == 1) { found_slavic = 1; }
    }
    assert_eq(found_kabbalah, 1, "has Kabbalah");
    assert_eq(found_hindu, 1, "has Hindu");
    assert_eq(found_norse, 1, "has Norse");
    assert_eq(found_greek, 1, "has Greek");
    assert_eq(found_aztec, 1, "has Aztec");
    assert_eq(found_jain, 1, "has Jain");
    assert_eq(found_sikh, 1, "has Sikh");
    assert_eq(found_polynesian, 1, "has Polynesian");
    assert_eq(found_slavic, 1, "has Slavic");

    # ================================================================
    # Compose: single profile is identity
    # ================================================================
    var tip = kabbalah_tiphareth();
    var single = vec_new();
    vec_push(single, weighted_new(tip, 1.0));
    var compR = compose(single);
    assert_eq(is_ok(compR), 1, "compose single ok");
    var comp = result_unwrap(compR);
    assert_eq(streq(prof_name(comp), "Tiphareth"), 1, "compose single name");
    assert_eq(prof_breath(comp), prof_breath(tip), "compose single breath");
    assert_eq(prof_growth_dir(comp), prof_growth_dir(tip), "compose single growth");

    # ================================================================
    # Compose: empty is error
    # ================================================================
    var empty = vec_new();
    assert_eq(is_err_result(compose(empty)), 1, "compose empty returns Err");

    # ================================================================
    # Compose: traits stay in range after blend
    # ================================================================
    var blend = vec_new();
    vec_push(blend, weighted_new(kabbalah_gevurah(), 1.0));
    vec_push(blend, weighted_new(kabbalah_chesed(), 1.0));
    var blended = result_unwrap(compose(blend));
    var blend_ok = 1;
    var off = TW_FIRST;
    while (off <= TW_LAST) {
        var v = load64(blended + off);
        if (f64_lt(v, 0.0) == 1) { blend_ok = 0; }
        if (f64_gt(v, 1.0) == 1) { blend_ok = 0; }
        off = off + 8;
    }
    assert_eq(blend_ok, 1, "compose blend traits in range");

    # ================================================================
    # History: mapped traditions count
    # ================================================================
    assert_eq(mapping_count(), 34, "34 history mappings");

    # ================================================================
    # History: all mapped traditions resolve
    # ================================================================
    var mt = mapped_traditions();
    var hist_ok = 1;
    for (var i = 0; i < vec_len(mt); i = i + 1) {
        var ctx = context_for_tradition(vec_get(mt, i));
        if (ctx == 0) { hist_ok = 0; }
    }
    assert_eq(hist_ok, 1, "all mapped traditions resolve context");

    # ================================================================
    # History: query_civilization returns profiles
    # ================================================================
    var greece_profiles = query_civilization("Ancient Greece");
    assert_gt(vec_len(greece_profiles), 0, "Ancient Greece has profiles");

    # ================================================================
    # History: query_era returns profiles
    # ================================================================
    var vedic_profiles = query_era("Vedic Period");
    assert_gt(vec_len(vedic_profiles), 0, "Vedic Period has profiles");

    # ================================================================
    # Affinity: self-affinity is ~1.0
    # ================================================================
    var tip2 = kabbalah_tiphareth();
    var self_aff = affinity(tip2, tip2);
    assert_eq(f64_ge(self_aff, 0.99), 1, "self affinity >= 0.99");

    # ================================================================
    # Affinity: different archetypes < 1.0
    # ================================================================
    var cross_aff = affinity(kabbalah_tiphareth(), kabbalah_gevurah());
    assert_eq(f64_lt(cross_aff, 1.0), 1, "tiphareth-gevurah < 1.0");
    assert_eq(f64_gt(cross_aff, 0.0), 1, "tiphareth-gevurah > 0.0");

    # ================================================================
    # Similarity: returns results, sorted descending
    # ================================================================
    var sim = similar_to(norse_thor(), 5);
    assert_eq(vec_len(sim), 5, "similar_to returns 5");
    assert_eq(f64_ge(sim_score(vec_get(sim, 0)), sim_score(vec_get(sim, 4))), 1, "sim sorted desc");
    # Bounded top-k selection (2.10.1) must stay equivalent to sort-then-trim:
    # every kept entry outranks every excluded candidate, and the bounded result
    # is a prefix of the fully sorted list.
    var sim_full = similar_to(norse_thor(), 0);
    assert_eq(vec_len(sim_full), profile_count() - 1, "unbounded similar_to returns every candidate");
    var sim_sorted_ok = 1;
    for (var si = 1; si < vec_len(sim_full); si = si + 1) {
        if (f64_gt(sim_score(vec_get(sim_full, si)), sim_score(vec_get(sim_full, si - 1))) == 1) {
            sim_sorted_ok = 0;
        }
    }
    assert_eq(sim_sorted_ok, 1, "unbounded similar_to fully sorted descending");
    var sim_prefix_ok = 1;
    for (var pj = 0; pj < vec_len(sim); pj = pj + 1) {
        if (f64_eq(sim_score(vec_get(sim, pj)), sim_score(vec_get(sim_full, pj))) != 1) {
            sim_prefix_ok = 0;
        }
    }
    assert_eq(sim_prefix_ok, 1, "top-5 is a score-identical prefix of the full sort");
    # the weakest kept entry outranks the strongest excluded candidate
    assert_eq(f64_ge(sim_score(vec_get(sim, 4)), sim_score(vec_get(sim_full, 5))), 1,
              "weakest kept >= strongest excluded (true top-k)");
    assert_eq(vec_len(similar_to(0, 5)), 0, "similar_to(NULL) is empty");

    # ================================================================
    # Cross-tradition match: different tradition
    # ================================================================
    var xt = cross_tradition_match(norse_thor());
    assert_neq(xt, 0, "thor has cross-tradition match");
    assert_eq(streq(prof_tradition(xt), "Norse") != 1, 1, "match is not Norse");

    # ================================================================
    # Conflicts: self has zero, opposites have some
    # ================================================================
    var self_conf = detect_conflicts(tip2, tip2);
    assert_eq(vec_len(self_conf), 0, "self conflicts = 0");
    var gev_ches = detect_conflicts(kabbalah_gevurah(), kabbalah_chesed());
    assert_gt(vec_len(gev_ches), 0, "gevurah-chesed has conflicts");

    # ================================================================
    # Shadow: inverted form, involutive
    # ================================================================
    var thor = norse_thor();
    var sh = shadow(thor);
    assert_neq(sh, 0, "shadow not null");
    assert_eq(is_shadow_of(sh, thor), 1, "shadow(thor) is shadow of thor");
    assert_eq(is_shadow_of(thor, thor), 0, "thor is not its own shadow");
    # high trait inverts to low: warmth + shadow warmth ~= 1.0
    assert_eq(f64_eq(f64_add(prof_warmth(thor), prof_warmth(sh)), 1.0), 1, "warmth inverts (sum=1)");
    # involution: shadow(shadow(x)) restores the inverted dimensions of x
    assert_eq(is_shadow_of(shadow(sh), sh), 1, "shadow is involutive");
    assert_eq(prof_breath(shadow(sh)), prof_breath(thor), "double-shadow restores breath");
    assert_eq(prof_growth_dir(shadow(sh)), prof_growth_dir(thor), "double-shadow restores growth");
    assert_eq(prof_polarity(shadow(sh)), prof_polarity(thor), "double-shadow restores polarity");
    # shadow shares tradition, element, tier
    assert_eq(streq(prof_tradition(sh), "Norse"), 1, "shadow keeps tradition");
    assert_eq(prof_element(sh), prof_element(thor), "shadow keeps element");

    # ================================================================
    # Domain: every archetype assigned; queries + spot-checks
    # ================================================================
    assert_eq(query_count_domain(DOMAIN_UNSPECIFIED), 0, "no archetype is domain-unspecified");
    assert_gt(vec_len(query_domain(DOMAIN_WAR)), 0, "war-domain archetypes exist");
    assert_eq(prof_domain(result_unwrap(lookup("Ares"))), DOMAIN_WAR, "Ares -> WAR");
    assert_eq(prof_domain(result_unwrap(lookup("Aphrodite"))), DOMAIN_LOVE, "Aphrodite -> LOVE");
    assert_eq(prof_domain(result_unwrap(lookup("Ra"))), DOMAIN_SUN, "Ra -> SUN");
    # query_count_domain agrees with query_domain length
    assert_eq(query_count_domain(DOMAIN_WAR), vec_len(query_domain(DOMAIN_WAR)), "domain count == filter len");

    # ================================================================
    # Solar: the intercalary archetypes — landing at the solar year
    # ================================================================
    assert_eq(solar_count(), 4, "4 solar archetypes");
    assert_eq(vec_len(by_tradition("Solar")), 4, "Solar tradition has 4");
    var leap = lookup_in("Solar", "Bissextus");
    assert_eq(is_ok(leap), 1, "Bissextus (the leap quarter) exists");
    assert_eq(prof_domain(result_unwrap(leap)), DOMAIN_ORDER, "Bissextus -> ORDER");
    # 366 (solar) + 8 (Canaanite/Etruscan) + 22 (Tarot) + 64 (I Ching) + 2 (Celtic) + 35 (world traditions) = 497
    assert_eq(profile_count(), 497, "497 archetypes");

    # ================================================================
    # Canaanite & Etruscan (2.7.0 micro-traditions)
    # ================================================================
    assert_eq(canaanite_count(), 4, "4 Canaanite");
    assert_eq(etruscan_count(), 4, "4 Etruscan");
    assert_eq(prof_domain(result_unwrap(lookup("Baal"))), DOMAIN_SKY, "Baal -> SKY");
    assert_eq(prof_domain(result_unwrap(lookup("Menrva"))), DOMAIN_WISDOM, "Menrva -> WISDOM");
    assert_eq(vec_len(by_tradition("Canaanite")), 4, "Canaanite tradition has 4");
    assert_eq(vec_len(by_tradition("Etruscan")), 4, "Etruscan tradition has 4");

    # ================================================================
    # Tarot Major Arcana (2.9.0) — 22 trumps as Tree-of-Life paths
    # ================================================================
    assert_eq(tarot_count(), 22, "22 Major Arcana");
    assert_eq(vec_len(by_tradition("Tarot")), 22, "Tarot tradition has 22");
    # registry lookup reaches the trumps
    assert_eq(is_ok(lookup("The Fool")), 1, "The Fool exists");
    assert_eq(streq(prof_tradition(result_unwrap(lookup("The Fool"))), "Tarot"), 1, "The Fool is Tarot");
    # domain spot-checks
    assert_eq(prof_domain(result_unwrap(lookup("Death"))), DOMAIN_DEATH, "Death -> DEATH");
    assert_eq(prof_domain(result_unwrap(lookup("The Sun"))), DOMAIN_SUN, "The Sun -> SUN");
    assert_eq(prof_domain(result_unwrap(lookup("Wheel of Fortune"))), DOMAIN_FATE, "Wheel of Fortune -> FATE");
    assert_eq(prof_domain(result_unwrap(lookup("Justice"))), DOMAIN_ORDER, "Justice -> ORDER");
    assert_eq(prof_domain(result_unwrap(lookup("The Empress"))), DOMAIN_NATURE, "The Empress -> NATURE");
    # all 22 trumps are cosmic-tier (mirroring the Sephiroth they bridge)
    var tarot_tier_ok = 1;
    var tv = all_tarot();
    for (var ti = 0; ti < vec_len(tv); ti = ti + 1) {
        if (prof_tier(vec_get(tv, ti)) != TIER_COSMIC) { tarot_tier_ok = 0; }
    }
    assert_eq(tarot_tier_ok, 1, "all Tarot trumps are cosmic-tier");
    # --- Kabbalah bridge: Golden Dawn path attributions ---
    assert_eq(tarot_path(ARCANA_FOOL), 11, "Fool = path 11");
    assert_eq(tarot_path(ARCANA_WORLD), 32, "World = path 32");
    assert_eq(streq(tarot_hebrew_letter(ARCANA_FOOL), "Aleph"), 1, "Fool letter = Aleph");
    assert_eq(streq(tarot_hebrew_letter(ARCANA_WORLD), "Tav"), 1, "World letter = Tav");
    # Fool's path (11) joins Kether and Chokmah
    assert_eq(tarot_path_upper(ARCANA_FOOL), SEPH_KETHER, "Fool path upper = Kether");
    assert_eq(tarot_path_lower(ARCANA_FOOL), SEPH_CHOKMAH, "Fool path lower = Chokmah");
    # Golden Dawn / RWS convention: VIII = Strength (Teth), XI = Justice (Lamed)
    assert_eq(tarot_index_by_name("Strength"), 8, "Strength is trump VIII");
    assert_eq(tarot_index_by_name("Justice"), 11, "Justice is trump XI");
    assert_eq(streq(tarot_hebrew_letter(ARCANA_STRENGTH), "Teth"), 1, "Strength letter = Teth");
    assert_eq(streq(tarot_hebrew_letter(ARCANA_JUSTICE), "Lamed"), 1, "Justice letter = Lamed");
    # Justice (path 22, Lamed) connects Gevurah and Tiphareth
    assert_eq(tarot_connects(ARCANA_JUSTICE, SEPH_GEVURAH), 1, "Justice touches Gevurah");
    assert_eq(tarot_connects(ARCANA_JUSTICE, SEPH_TIPHARETH), 1, "Justice touches Tiphareth");
    assert_eq(tarot_connects(ARCANA_JUSTICE, SEPH_MALKUTH), 0, "Justice does not touch Malkuth");
    # tarot_for_path is the inverse of tarot_path; Sephira-range / OOB numbers -> -1
    assert_eq(tarot_for_path(11), ARCANA_FOOL, "path 11 -> Fool");
    assert_eq(tarot_for_path(32), ARCANA_WORLD, "path 32 -> World");
    assert_eq(tarot_for_path(10), 0 - 1, "path 10 (a Sephira) -> -1");
    assert_eq(tarot_for_path(33), 0 - 1, "path 33 (out of range) -> -1");
    # round-trip path <-> index over all 22
    var tarot_roundtrip_ok = 1;
    for (var pi = 0; pi < 22; pi = pi + 1) {
        if (tarot_for_path(tarot_path(pi)) != pi) { tarot_roundtrip_ok = 0; }
    }
    assert_eq(tarot_roundtrip_ok, 1, "path<->index round-trips for all 22 trumps");
    # each trump's path joins two DISTINCT sephiroth, both in 0..9
    var tarot_paths_ok = 1;
    for (var qi = 0; qi < 22; qi = qi + 1) {
        var up = tarot_path_upper(qi);
        var lo = tarot_path_lower(qi);
        if (up == lo) { tarot_paths_ok = 0; }
        if (up < 0) { tarot_paths_ok = 0; }
        if (up > 9) { tarot_paths_ok = 0; }
        if (lo < 0) { tarot_paths_ok = 0; }
        if (lo > 9) { tarot_paths_ok = 0; }
    }
    assert_eq(tarot_paths_ok, 1, "all 22 paths join two distinct sephiroth (0..9)");
    # by-index and by-name helpers
    assert_eq(streq(prof_name(tarot_by_index(0)), "The Fool"), 1, "tarot_by_index(0) = The Fool");
    assert_eq(tarot_by_index(0 - 1), 0, "tarot_by_index(-1) = 0 (null)");
    assert_eq(tarot_index_by_name("Death"), 13, "index_by_name Death = 13");
    assert_eq(tarot_index_by_name("nope"), 0 - 1, "index_by_name unknown = -1");
    # history: Tarot resolves a context
    assert_neq(context_for_tradition("Tarot"), 0, "Tarot resolves history context");

    # ================================================================
    # I Ching (2.10.0) — 64 hexagrams over the eight trigrams
    # ================================================================
    assert_eq(iching_count(), 64, "64 hexagrams");
    assert_eq(trigram_count(), 8, "8 trigrams");
    assert_eq(vec_len(by_tradition("I Ching")), 64, "I Ching tradition has 64");
    # trigram value IS its 3-line code, bottom line as MSB
    assert_eq(TRIGRAM_KUN, 0, "Kun = 000 = 0");
    assert_eq(TRIGRAM_QIAN, 7, "Qian = 111 = 7");
    assert_eq(trigram_line(TRIGRAM_ZHEN, 1), 1, "Zhen (100) bottom line yang");
    assert_eq(trigram_line(TRIGRAM_ZHEN, 3), 0, "Zhen (100) top line yin");
    assert_eq(streq(trigram_image(TRIGRAM_GEN), "Mountain"), 1, "Gen image = Mountain");
    assert_eq(streq(trigram_family(TRIGRAM_QIAN), "Father"), 1, "Qian family = Father");
    assert_eq(trigram_element(TRIGRAM_LI), ELEM_FIRE, "Li element = FIRE");
    # King Wen numbering
    assert_eq(iching_number(HEX_01_QIAN), 1, "index 0 -> King Wen 1");
    assert_eq(iching_number(HEX_64_WEI_JI), 64, "index 63 -> King Wen 64");
    # canonical compositions (upper over lower)
    assert_eq(iching_lower(HEX_11_TAI), TRIGRAM_QIAN, "Tai lower = Qian (Heaven)");
    assert_eq(iching_upper(HEX_11_TAI), TRIGRAM_KUN, "Tai upper = Kun (Earth over Heaven)");
    assert_eq(iching_lower(HEX_12_PI), TRIGRAM_KUN, "Pi lower = Kun");
    assert_eq(iching_upper(HEX_12_PI), TRIGRAM_QIAN, "Pi upper = Qian (Heaven over Earth)");
    assert_eq(iching_lower(HEX_63_JI_JI), TRIGRAM_LI, "Ji Ji lower = Li");
    assert_eq(iching_upper(HEX_63_JI_JI), TRIGRAM_KAN, "Ji Ji upper = Kan (Water over Fire)");
    assert_eq(iching_lower(HEX_64_WEI_JI), TRIGRAM_KAN, "Wei Ji lower = Kan");
    assert_eq(iching_upper(HEX_64_WEI_JI), TRIGRAM_LI, "Wei Ji upper = Li (Fire over Water)");
    # the eight doubled hexagrams have lower == upper
    var doubled = 0;
    for (var di = 0; di < 64; di = di + 1) {
        if (iching_lower(di) == iching_upper(di)) { doubled = doubled + 1; }
    }
    assert_eq(doubled, 8, "exactly 8 doubled hexagrams");
    assert_eq(iching_lower(HEX_29_KAN), iching_upper(HEX_29_KAN), "Kan is doubled");
    assert_eq(iching_lower(HEX_52_GEN), iching_upper(HEX_52_GEN), "Gen is doubled");
    # BIJECTION: every one of the 8x8 trigram pairings occurs exactly once
    var bijection_ok = 1;
    for (var lo = 0; lo < 8; lo = lo + 1) {
        for (var up = 0; up < 8; up = up + 1) {
            var hx = iching_for_trigrams(lo, up);
            if (hx < 0) { bijection_ok = 0; }
            if (hx >= 0) {
                if (iching_lower(hx) != lo) { bijection_ok = 0; }
                if (iching_upper(hx) != up) { bijection_ok = 0; }
            }
        }
    }
    assert_eq(bijection_ok, 1, "all 64 trigram pairings map to a hexagram (bijection)");
    # line access agrees with the trigram decomposition, and yang counts are sane
    var lines_ok = 1;
    for (var li = 0; li < 64; li = li + 1) {
        for (var lp = 1; lp <= 3; lp = lp + 1) {
            if (iching_line(li, lp) != trigram_line(iching_lower(li), lp)) { lines_ok = 0; }
            if (iching_line(li, lp + 3) != trigram_line(iching_upper(li), lp)) { lines_ok = 0; }
        }
        var yc = iching_yang_count(li);
        if (yc < 0) { lines_ok = 0; }
        if (yc > 6) { lines_ok = 0; }
    }
    assert_eq(lines_ok, 1, "lines 1-6 decompose to lower/upper trigrams for all 64");
    assert_eq(iching_yang_count(HEX_01_QIAN), 6, "The Creative is six yang lines");
    assert_eq(iching_yang_count(HEX_02_KUN), 0, "The Receptive is six yin lines");
    # the DOCUMENTED derivation rules actually hold across all 64
    var elem_rule_ok = 1;
    var pol_rule_ok = 1;
    var tier_ok = 1;
    var iv = all_iching();
    for (var ri = 0; ri < vec_len(iv); ri = ri + 1) {
        var hp = vec_get(iv, ri);
        if (prof_element(hp) != trigram_element(iching_upper(ri))) { elem_rule_ok = 0; }
        if (prof_tier(hp) != TIER_COSMIC) { tier_ok = 0; }
        var y = iching_yang_count(ri);
        if (y >= 4) { if (prof_polarity(hp) != POL_MASCULINE) { pol_rule_ok = 0; } }
        if (y <= 2) { if (prof_polarity(hp) != POL_FEMININE) { pol_rule_ok = 0; } }
        if (y == 3) { if (prof_polarity(hp) != POL_ANDROGYNOUS) { pol_rule_ok = 0; } }
    }
    assert_eq(elem_rule_ok, 1, "element == upper trigram's element for all 64");
    assert_eq(pol_rule_ok, 1, "polarity follows the yang-line balance for all 64");
    assert_eq(tier_ok, 1, "all 64 hexagrams are cosmic-tier");
    # lookup helpers and domain spot-checks
    assert_eq(streq(prof_name(iching_by_number(1)), "The Creative"), 1, "hexagram 1 = The Creative");
    assert_eq(streq(prof_name(iching_by_number(64)), "Before Completion"), 1, "hexagram 64 = Before Completion");
    assert_eq(iching_index_by_name("Modesty"), 14, "Modesty is index 14 (hexagram 15)");
    assert_eq(iching_index_by_name("nope"), 0 - 1, "index_by_name unknown = -1");
    assert_eq(prof_domain(result_unwrap(lookup("The Creative"))), DOMAIN_CREATION, "The Creative -> CREATION");
    assert_eq(prof_domain(result_unwrap(lookup("The Receptive"))), DOMAIN_NATURE, "The Receptive -> NATURE");
    assert_eq(prof_domain(result_unwrap(lookup("Keeping Still"))), DOMAIN_TRANSCENDENCE, "Keeping Still -> TRANSCENDENCE");
    assert_eq(prof_domain(result_unwrap(lookup("The Well"))), DOMAIN_HEARTH, "The Well -> HEARTH");
    # out-of-range behavior
    assert_eq(iching_by_index(0 - 1), 0, "iching_by_index(-1) = 0 (null)");
    assert_eq(iching_by_index(64), 0, "iching_by_index(64) = 0 (null)");
    assert_eq(iching_code(64), 0 - 1, "iching_code out of range = -1");
    assert_eq(iching_line(0, 7), 0 - 1, "line position 7 = -1");
    assert_eq(iching_for_trigrams(0 - 1, 0), 0 - 1, "for_trigrams bad lower = -1");
    assert_eq(iching_for_trigrams(0, 8), 0 - 1, "for_trigrams bad upper = -1");
    # history
    assert_neq(context_for_tradition("I Ching"), 0, "I Ching resolves history context");

    # ================================================================
    # World traditions (2.11.0) — named-nation traditions
    # ================================================================
    assert_eq(inuit_count(), 10, "10 Inuit spirits");
    assert_eq(lakota_count(), 10, "10 Lakota powers");
    assert_eq(haudenosaunee_count(), 6, "6 Haudenosaunee figures");
    assert_eq(anishinaabe_count(), 5, "5 Anishinaabe manidoog");
    assert_eq(aboriginal_count(), 4, "4 Aboriginal Australian figures");
    assert_eq(vec_len(by_tradition("Inuit")), 10, "Inuit tradition has 10");
    assert_eq(vec_len(by_tradition("Lakota")), 10, "Lakota tradition has 10");
    assert_eq(vec_len(by_tradition("Haudenosaunee")), 6, "Haudenosaunee tradition has 6");
    assert_eq(vec_len(by_tradition("Anishinaabe")), 5, "Anishinaabe tradition has 5");
    assert_eq(vec_len(by_tradition("Aboriginal Australian")), 4, "Aboriginal Australian tradition has 4");
    # each is a distinct named-nation tradition, not one pan-indigenous bucket
    var wt = all_traditions();
    var found_inuit = 0; var found_lakota = 0; var found_haud = 0;
    var found_anish = 0; var found_abor = 0;
    for (var wi = 0; wi < vec_len(wt); wi = wi + 1) {
        var wn = vec_get(wt, wi);
        if (streq(wn, "Inuit") == 1) { found_inuit = 1; }
        if (streq(wn, "Lakota") == 1) { found_lakota = 1; }
        if (streq(wn, "Haudenosaunee") == 1) { found_haud = 1; }
        if (streq(wn, "Anishinaabe") == 1) { found_anish = 1; }
        if (streq(wn, "Aboriginal Australian") == 1) { found_abor = 1; }
    }
    assert_eq(found_inuit, 1, "has Inuit");
    assert_eq(found_lakota, 1, "has Lakota");
    assert_eq(found_haud, 1, "has Haudenosaunee");
    assert_eq(found_anish, 1, "has Anishinaabe");
    assert_eq(found_abor, 1, "has Aboriginal Australian");
    # domain spot-checks
    assert_eq(prof_domain(result_unwrap(lookup("Sedna"))), DOMAIN_SEA, "Sedna -> SEA");
    assert_eq(prof_domain(result_unwrap(lookup("Sila"))), DOMAIN_TRANSCENDENCE, "Sila -> TRANSCENDENCE");
    assert_eq(prof_domain(result_unwrap(lookup("Wakan Tanka"))), DOMAIN_TRANSCENDENCE, "Wakan Tanka -> TRANSCENDENCE");
    assert_eq(prof_domain(result_unwrap(lookup("Iktomi"))), DOMAIN_TRICKERY, "Iktomi -> TRICKERY");
    assert_eq(prof_domain(result_unwrap(lookup("Sky Woman"))), DOMAIN_CREATION, "Sky Woman -> CREATION");
    assert_eq(prof_domain(result_unwrap(lookup("Nanabozho"))), DOMAIN_TRICKERY, "Nanabozho -> TRICKERY");
    assert_eq(prof_domain(result_unwrap(lookup("Bunjil"))), DOMAIN_CREATION, "Bunjil -> CREATION");
    assert_eq(is_err_result(lookup("Baiame")), 1, "Baiame deferred to the 2.11.x arc");
    assert_eq(is_err_result(lookup("Wiindigoo")), 1, "Wiindigoo deliberately not carried");
    # White Buffalo Calf Woman and Deganawidah stay in the "Indigenous" incarnate
    # tradition and are NOT duplicated into the new nation modules
    assert_eq(streq(prof_tradition(result_unwrap(lookup("White Buffalo Calf Woman"))), "Indigenous"), 1,
              "White Buffalo Calf Woman stays under Indigenous");
    assert_eq(vec_len(by_tradition("Indigenous")), 4, "Indigenous tradition still has 4");
    # history: every new tradition resolves a context
    assert_neq(context_for_tradition("Inuit"), 0, "Inuit resolves history context");
    assert_neq(context_for_tradition("Lakota"), 0, "Lakota resolves history context");
    assert_neq(context_for_tradition("Haudenosaunee"), 0, "Haudenosaunee resolves history context");
    assert_neq(context_for_tradition("Anishinaabe"), 0, "Anishinaabe resolves history context");
    assert_neq(context_for_tradition("Aboriginal Australian"), 0, "Aboriginal Australian resolves history context");
    # the Aboriginal mapping reaches back 65,000 years and is still living
    var abor_ctx = context_for_tradition("Aboriginal Australian");
    assert_eq(ctx_start(abor_ctx) < (0 - 60000), 1, "Aboriginal Australian starts before 60,000 BCE");
    assert_eq(ctx_end(abor_ctx), LIVING, "Aboriginal Australian is a living tradition");

    # ================================================================
    # Aspects (role derivation from the personality vector) — aspect.cyr
    # ================================================================
    assert_eq(aspect_count(), 8, "8 aspects");
    assert_eq(streq(aspect_name(2), "measurer"), 1, "aspect 2 name = measurer");
    assert_eq(streq(aspect_role(2), "the Measurer"), 1, "aspect 2 role = the Measurer");
    assert_eq(aspect_trait_offset(2), PROF_PRECISION, "aspect 2 derives from precision");
    assert_eq(aspect_index_by_name("mediator"), 5, "index_by_name mediator = 5");
    assert_eq(aspect_index_by_name("nope"), 0 - 1, "index_by_name unknown = -1");
    assert_eq(aspect_index_by_name(0), 0 - 1, "index_by_name null = -1");
    # dominant aspect follows the strongest mapped trait (profile_new -> all traits 0.5)
    var ap = profile_new();
    Profile_set_precision(ap, 0.99);
    assert_eq(profile_dominant_aspect(ap), 2, "precision-dominant profile -> aspect 2 (measurer)");
    Profile_set_empathy(ap, 1.0);
    assert_eq(profile_dominant_aspect(ap), 5, "empathy strongest -> aspect 5 (mediator)");
    assert_eq(f64_gt(profile_aspect_weight(ap, 5), profile_aspect_weight(ap, 0)), 1, "aspect_weight reads the trait (empathy > curiosity)");
    assert_eq(profile_dominant_aspect(0), 0, "null profile -> aspect 0 (safe default)");

    return assert_summary();
}

var rc = main();
syscall(60, rc);
