[package]
name = "avatara"
version = "${file:VERSION}"
description = "Avatara — divine archetype engine: theological and mythological personality mapping across traditions"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.7.18"
repository = "https://github.com/MacCracken/avatara"

[build]
entry = "src/main.cyr"
output = "build/avatara"

# `cyrius distlib` reads [lib] to build dist/avatara.cyr and [lib.json] to build
# dist/avatara-json.cyr:
#   cyrius distlib       → dist/avatara.cyr       (the engine; never calls bayan)
#   cyrius distlib json  → dist/avatara-json.cyr  (the engine + src/json.cyr)
[lib]
# The bundle consumers (bhava, joshua, kiran, agnosai, hadara, sankhya) include.
# Order matches src/lib.cyr's include order; lib.cyr itself is listed last.
modules = [
    "src/types.cyr",
    "src/aspect.cyr",
    "src/error.cyr",
    "src/kabbalah.cyr",
    "src/angelic.cyr",
    "src/hindu.cyr",
    "src/olympian.cyr",
    "src/norse.cyr",
    "src/egyptian.cyr",
    "src/buddhist.cyr",
    "src/mesopotamian.cyr",
    "src/celtic.cyr",
    "src/shinto.cyr",
    "src/aztec.cyr",
    "src/maya.cyr",
    "src/yoruba.cyr",
    "src/zoroastrian.cyr",
    "src/taoist.cyr",
    "src/polynesian.cyr",
    "src/slavic.cyr",
    "src/jain.cyr",
    "src/sikh.cyr",
    "src/incarnate.cyr",
    "src/finnish.cyr",
    "src/vodou.cyr",
    "src/solar.cyr",
    "src/canaanite.cyr",
    "src/etruscan.cyr",
    "src/tarot.cyr",
    "src/iching.cyr",
    "src/inuit.cyr",
    "src/lakota.cyr",
    "src/haudenosaunee.cyr",
    "src/anishinaabe.cyr",
    "src/aboriginal.cyr",
    "src/compose.cyr",
    "src/history.cyr",
    "src/registry.cyr",
    "src/affinity.cyr",
    "src/shadow.cyr",
    "src/overlay.cyr",
    "src/logging.cyr",
    "src/lib.cyr",
]

# The engine plus src/json.cyr, the ArchetypeProfile JSON codec (ADR-011). A
# superset of dist/avatara.cyr, so a consumer folds one or the other, never both.
# JSON calls bayan, and this is the only bundle that does, so dist/avatara.cyr
# stays bayan-free and the "zero external dependencies except sakshi" rule holds
# for every consumer that does not ask for JSON. A consumer folding this one
# declares bayan itself, in ONE of two forms and never both (both define the same
# JSON symbols twice, and the last definition wins):
#   - the "bayan" stdlib monolith in its [deps].stdlib, as sankhya does; or
#   - bayan's thin profile:
#       [deps.bayan]
#       git = "https://github.com/MacCracken/bayan.git"
#       tag = "1.11.1"
#       modules = ["dist/bayan-json.cyr"]
# With neither, the build refuses, naming the bayan_json_* calls. The sidecar
# (dist/avatara-json.deps) lists neither, because which one is the consumer's choice.
# json.cyr sits before lib.cyr so lib.cyr stays last, as in [lib].
[lib.json]
modules = [
    "src/types.cyr",
    "src/aspect.cyr",
    "src/error.cyr",
    "src/kabbalah.cyr",
    "src/angelic.cyr",
    "src/hindu.cyr",
    "src/olympian.cyr",
    "src/norse.cyr",
    "src/egyptian.cyr",
    "src/buddhist.cyr",
    "src/mesopotamian.cyr",
    "src/celtic.cyr",
    "src/shinto.cyr",
    "src/aztec.cyr",
    "src/maya.cyr",
    "src/yoruba.cyr",
    "src/zoroastrian.cyr",
    "src/taoist.cyr",
    "src/polynesian.cyr",
    "src/slavic.cyr",
    "src/jain.cyr",
    "src/sikh.cyr",
    "src/incarnate.cyr",
    "src/finnish.cyr",
    "src/vodou.cyr",
    "src/solar.cyr",
    "src/canaanite.cyr",
    "src/etruscan.cyr",
    "src/tarot.cyr",
    "src/iching.cyr",
    "src/inuit.cyr",
    "src/lakota.cyr",
    "src/haudenosaunee.cyr",
    "src/anishinaabe.cyr",
    "src/aboriginal.cyr",
    "src/compose.cyr",
    "src/history.cyr",
    "src/registry.cyr",
    "src/affinity.cyr",
    "src/shadow.cyr",
    "src/overlay.cyr",
    "src/logging.cyr",
    "src/json.cyr",
    "src/lib.cyr",
]

[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "vec", "math", "hashmap", "io", "args", "assert", "bench", "tagged", "result", "fnptr", "sakshi"]

# --- bayan: JSON for src/json.cyr only (ADR-011) ----------------------
# The thin dist/bayan-json.cyr profile, NOT the "bayan" stdlib monolith: the
# monolith carries ~353 KB of Unicode tables DCE cannot drop. Never list "bayan"
# in [deps].stdlib as well — both files would be vendored and the JSON symbols
# defined twice. The profile omits the short json_v_* aliases; src/json.cyr calls
# the qualified bayan_json_v_* names, which both forms define.
#
# The tag tracks the bayan the toolchain pin vendors (cyrius 6.7.18 → bayan
# 1.11.1), the tag varna 2.5.2 takes for the same purpose.
#
# Optional, on by default: [features] resolve from the ROOT manifest only, so
# avatara's own builds, tests and benches get it and downstream consumers do not.
# That keeps the choice of bayan form the consumer's (see [lib.json] above) and
# keeps it out of dist/avatara.deps / dist/avatara-json.deps.
[features]
default = ["bayan"]

[deps.bayan]
optional = true
git = "https://github.com/MacCracken/bayan.git"
tag = "1.11.1"
modules = ["dist/bayan-json.cyr"]
