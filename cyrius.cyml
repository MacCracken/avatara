[package]
name = "avatara"
version = "${file:VERSION}"
description = "Avatara — divine archetype engine: theological and mythological personality mapping across traditions"
license = "GPL-3.0-only"
language = "cyrius"
cyrius = "6.4.69"
repository = "https://github.com/MacCracken/avatara"

[build]
entry = "src/main.cyr"
output = "build/avatara"

[lib]
# `cyrius distlib` reads this section to build dist/avatara.cyr — the single
# bundle consumers (bhava, joshua, kiran, agnosai, hadara) include. Order
# matches src/lib.cyr's include order; lib.cyr itself is listed last.
modules = [
    "src/types.cyr",
    "src/aspect.cyr",
    "src/error.cyr",
    "src/kabbalah.cyr",
    "src/angelic.cyr",
    "src/hindu.cyr",
    "src/olympian.cyr",
    "src/norse.cyr",
    "src/egyptian.cyr",
    "src/buddhist.cyr",
    "src/mesopotamian.cyr",
    "src/celtic.cyr",
    "src/shinto.cyr",
    "src/aztec.cyr",
    "src/maya.cyr",
    "src/yoruba.cyr",
    "src/zoroastrian.cyr",
    "src/taoist.cyr",
    "src/polynesian.cyr",
    "src/slavic.cyr",
    "src/jain.cyr",
    "src/sikh.cyr",
    "src/incarnate.cyr",
    "src/finnish.cyr",
    "src/vodou.cyr",
    "src/solar.cyr",
    "src/canaanite.cyr",
    "src/etruscan.cyr",
    "src/tarot.cyr",
    "src/compose.cyr",
    "src/history.cyr",
    "src/registry.cyr",
    "src/affinity.cyr",
    "src/shadow.cyr",
    "src/logging.cyr",
    "src/lib.cyr",
]

[deps]
stdlib = ["syscalls", "string", "alloc", "str", "fmt", "vec", "math", "hashmap", "io", "args", "assert", "bench", "tagged", "result", "fnptr", "sakshi"]
