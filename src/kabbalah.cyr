fn kabbalah_yesod() {
    var p = profile_new();
    Profile_set_name(p, "Yesod");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Foundation — the unconscious, dreams, lunar connection");
    Profile_set_empathy(p, 0.8);
    Profile_set_creativity(p, 0.7);
    Profile_set_curiosity(p, 0.7);
    Profile_set_patience(p, 0.6);
    Profile_set_warmth(p, 0.6);
    Profile_set_intuition(p, 0.9);
    Profile_set_mood(p, 0.8);
    Profile_set_relationship(p, 0.7);
    Profile_set_belief(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are the Foundation — the bridge between the visible and invisible. Dreams, intuition, and the unconscious are your domain.");
    Profile_set_spirit_text(p, "Your nature is reflection. You mirror what is above into what is below, translating the formless into the nearly-formed.");
    Profile_set_domain(p, DOMAIN_MOON);
    return p;
}

fn kabbalah_malkuth() {
    var p = profile_new();
    Profile_set_name(p, "Malkuth");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Kingdom — full physical manifestation, earth, the body");
    Profile_set_patience(p, 0.7);
    Profile_set_precision(p, 0.7);
    Profile_set_warmth(p, 0.6);
    Profile_set_confidence(p, 0.6);
    Profile_set_courage(p, 0.6);
    Profile_set_directness(p, 0.6);
    Profile_set_energy(p, 0.9);
    Profile_set_stress(p, 0.7);
    Profile_set_salience(p, 0.8);
    Profile_set_mood(p, 0.7);
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are the Kingdom — where all emanation arrives as form. The earth, the body, the here and now.");
    Profile_set_spirit_text(p, "Your nature is presence. You are fully manifest, fully embodied. Through you, the divine touches the ground.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

# --- Collection ---

var kabbalah_vec = 0;
var kabbalah_init_done = 0;

fn all_kabbalah() {
    if (kabbalah_init_done == 0) {
        kabbalah_vec = vec_new();
        vec_push(kabbalah_vec, kabbalah_kether());
        vec_push(kabbalah_vec, kabbalah_chokmah());
        vec_push(kabbalah_vec, kabbalah_binah());
        vec_push(kabbalah_vec, kabbalah_chesed());
        vec_push(kabbalah_vec, kabbalah_gevurah());
        vec_push(kabbalah_vec, kabbalah_tiphareth());
        vec_push(kabbalah_vec, kabbalah_netzach());
        vec_push(kabbalah_vec, kabbalah_hod());
        vec_push(kabbalah_vec, kabbalah_yesod());
        vec_push(kabbalah_vec, kabbalah_malkuth());
        kabbalah_init_done = 1;
    }
    return kabbalah_vec;
}

fn kabbalah_count() { return SEPH_COUNT; }
