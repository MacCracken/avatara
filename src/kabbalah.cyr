fn kabbalah_gevurah() {
    var p = profile_new();
    Profile_set_name(p, "Gevurah");
    Profile_set_tradition(p, "Kabbalah");
    Profile_set_desc(p, "Severity — discipline, judgment, necessary boundaries");
    Profile_set_directness(p, 0.9);
    Profile_set_confidence(p, 0.9);
    Profile_set_courage(p, 0.9);
    Profile_set_skepticism(p, 0.8);
    Profile_set_precision(p, 0.8);
    Profile_set_patience(p, 0.3);
    Profile_set_warmth(p, 0.3);
    Profile_set_humor(p, 0.2);
