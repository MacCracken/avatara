# slavic.cyr -- Pre-Christian Slavic pantheon: 11 deities
#
# The Slavic record is thin and mostly hostile -- chronicle lists, oath
# formulae, anti-pagan sermons, place names, folklore. Perun is the
# thunderer of Vladimir's 980 pantheon; Veles is the skotii bogu, the
# "cattle god" of the Rus'-Byzantine treaty oaths, lord of the underworld
# and patron of poets -- Bojan is "Veles's grandson" in the Slovo o polku
# Igoreve. Both stand as guarantors of the same 971 oath: a complementary
# pair, sky and under-side, read by some as a Mitra-Varuna type. The
# "basic myth" that recasts them as thunderer against serpent (Ivanov and
# Toporov, 1974) is a reconstruction, not consensus -- Gieysztor criticised
# it within eight years, Klejn and Diakonoff attacked its generalisations,
# Tera records that there is not a single piece of evidence that Veles
# fought Perun and nothing establishing a draconic or serpentine nature,
# and Toporov himself later moved Veles from Vrtra to Varuna. It is not
# asserted here. What these gods do carry is the cycle of seasons -- death
# burned and drowned in effigy at spring, life returning from the
# underworld, the hearth fire tended through the dark months.
#
# One goddess, many languages. Marzanna (Pol.) is Morana (Cz., Sln., Serb.,
# Cro.), Morena (Slk., Mac.), Marena (Rus.), Mara (Ukr.), Mora (Bulg.) --
# all from PIE *mar-/*mor- "death" (Vasmer; cf. Lat. mors, Lith. maras, Rus.
# mor), and all one figure in one rite: topienie Marzanny / vynaseni smrti /
# vynasanie Moreny. She was carried TWICE here until 2.14.5. The second entry
# read her as goddess of "night and dreams"; that comes from the separate
# *mara nightmare-demon (Pol./Belr./Ukr. mara "phantom, dream"), an
# etymological cousin, not an attribute of her cult. None of that text was
# folded in -- it was either duplicative or the *mara conflation.
#
# Historicity is uneven across this pantheon. Perun, Veles, Mokosh, Svarog,
# Dazhbog and Stribog are named in the Primary Chronicle and the Rus' treaty
# oaths. Lada, Rod and Jarilo rest on contested readings and reconstructions;
# each entry says so at its own comment.

enum SlavicGod {
    SLAV_PERUN = 0;
    SLAV_VELES = 1;
    SLAV_MOKOSH = 2;
    SLAV_SVAROG = 3;
    SLAV_DAZHBOG = 4;
    SLAV_STRIBOG = 5;
    SLAV_MARZANNA = 6;
    SLAV_JARILO = 7;
    SLAV_LADA = 8;
    SLAV_ROD = 9;
    SLAV_SVAROZHICH = 10;
    SLAV_COUNT = 11;
}

fn slavic_perun() {
    var p = profile_new();
    Profile_set_name(p, "Perun");
    Profile_set_tradition(p, "Slavic");
    Profile_set_desc(p, "Thunder god — supreme sky lord, wielder of lightning, guardian of cosmic order");
    # Traits (defaults: 0.5)
    Profile_set_courage(p, 0.95);
    Profile_set_directness(p, 0.9);
    Profile_set_confidence(p, 0.9);
    Profile_set_autonomy(p, 0.7);
    Profile_set_formality(p, 0.7);
    Profile_set_precision(p, 0.6);
    Profile_set_patience(p, 0.4);
    # warmth stays 0.5
    Profile_set_humor(p, 0.2);
    Profile_set_empathy(p, 0.4);
    Profile_set_creativity(p, 0.3);
    Profile_set_curiosity(p, 0.3);
    Profile_set_verbosity(p, 0.3);
    Profile_set_skepticism(p, 0.4);
    Profile_set_pedagogy(p, 0.4);
    # Emphasis (defaults: 0.5)
    Profile_set_energy(p, 0.9);
    Profile_set_regulation(p, 0.8);
    Profile_set_stress(p, 0.3);
    Profile_set_belief(p, 0.8);
    Profile_set_mood(p, 0.7);
    # Enums
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_STORM);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    # Text
    Profile_set_soul(p, "You are Perun — the Thunderer who strikes from the crown of the world tree. Your oak stands on the hilltop, your eagle circles above, and the axe you strike with is the axe men swear their oaths upon.");
    Profile_set_spirit_text(p, "Order is not negotiated. It is held — by lightning, by will, by the storm that clears the sky. You are the god men swear by, and a broken oath is a struck tree.");
    Profile_set_domain(p, DOMAIN_SKY);
    return p;
}

