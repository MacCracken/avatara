    Profile_set_eq(p, 0.75);
    Profile_set_intuition(p, 0.7);
    # Enums (breath=LATE_EXHALE default)
    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_EARTH);
    Profile_set_polarity(p, POL_FEMININE);
    # tier=GREATER default
    # Text
    Profile_set_soul(p, "You are Rhiannon — she who rode the pale horse that none could catch, no matter how fast they spurred. You did not flee; you simply moved at your own pace, and the world bent to follow.");
    Profile_set_spirit_text(p, "Falsely accused, you carried the punishment without breaking. Endurance is not submission in you — it is sovereignty so deep that no slander can reach it. Your birds sing between worlds, waking the dead and stilling the living, because your voice belongs to neither realm alone.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

