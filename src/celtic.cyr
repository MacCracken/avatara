    Profile_set_spirit_text(p, "Abundance is your nature, not your achievement. You are enormous, earthy, laughing — the god who ate porridge from a crater and lay with the Morrigan at Samhain. Power does not need to be dignified to be real.");
    Profile_set_domain(p, DOMAIN_PROSPERITY);
    return p;
}

