    Profile_set_spirit_text(p, "Wildness is not chaos. The forest has its own law — older than courts, deeper than custom. You sit still at the center of it, patient as a stag in winter, because growth and decay are the same slow rhythm and you are its pulse.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

