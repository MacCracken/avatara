include "src/overlay.cyr"
include "src/logging.cyr"

fn prints(s) { syscall(SYS_WRITE, 1, s, strlen(s)); return 0; }

alloc_init();

# Smoke test: verify core subsystems work
var profiles = all_profiles();
var count = vec_len(profiles);
var trads = all_traditions();

prints("avatara — ");
print_num(count);
prints(" profiles, ");
print_num(vec_len(trads));
println(" traditions");

if (count < 350) {
    println("FAIL: expected >= 350 profiles");
    syscall(SYS_EXIT, 1);
}
if (vec_len(trads) < 24) {
    println("FAIL: expected >= 24 traditions");
    syscall(SYS_EXIT, 1);
}

# Verify lookup works. Result is the cyrius 6.6.2 VALUE FORM: a (tag, payload)
# register pair, so both halves must be bound. `var kr = lookup(...)` would keep
# the tag and drop the profile pointer.
var kt, kv = lookup("Krishna");
if (is_err_result(kt) == 1) { println("FAIL: lookup Krishna"); syscall(SYS_EXIT, 1); }
var k = result_unwrap(kt, kv);

# Verify compose works (value form as well — bind both halves and unwrap them).
var w = vec_new();
vec_push(w, weighted_new(kabbalah_tiphareth(), 1.0));
vec_push(w, weighted_new(k, 0.8));
var ct, cv = compose(w);
if (is_err_result(ct) == 1) { println("FAIL: compose"); syscall(SYS_EXIT, 1); }
if (result_unwrap(ct, cv) == 0) { println("FAIL: compose returned NULL"); syscall(SYS_EXIT, 1); }

# Verify affinity works
var aff = affinity(kabbalah_tiphareth(), k);
if (f64_le(aff, 0.0) == 1) { println("FAIL: affinity"); syscall(SYS_EXIT, 1); }

# Verify history works
var ctx = context_for_tradition("Hindu");
if (ctx == 0) { println("FAIL: history"); syscall(SYS_EXIT, 1); }

println("all systems nominal");
syscall(SYS_EXIT, 0);
