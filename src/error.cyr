# error.cyr -- Error codes for avatara

enum AvataraError {
    ERR_NONE = 0;
    ERR_INVALID_PARAMETER = 1;
    ERR_UNKNOWN_ARCHETYPE = 2;
    ERR_INCOMPATIBLE = 3;
    ERR_OUT_OF_RANGE = 4;
}

# Validate f64 is in 0.0-1.0 range. Returns 0 on success, ERR_OUT_OF_RANGE on failure.
# NaN is rejected explicitly: every ordered comparison against NaN is false, so
# f64_lt/f64_gt alone certified NaN as in-range and validate_profile() returned
# Ok() for a profile whose traits were all NaN (fixed 2.14.3). `f64_eq(v, v) == 0`
# is the same NaN test compose() already uses on its weights.
fn require_unit_range(val) {
    if (f64_eq(val, val) == 0) { return ERR_OUT_OF_RANGE; }
    if (f64_lt(val, 0.0) == 1) { return ERR_OUT_OF_RANGE; }
    if (f64_gt(val, 1.0) == 1) { return ERR_OUT_OF_RANGE; }
    return ERR_NONE;
}

# Validate all f64 values in a profile's trait range are in 0.0-1.0.
# p: profile pointer, first: first offset, last: last offset
fn require_all_unit_range(p, first, last) {
    var off = first;
    while (off <= last) {
        var r = require_unit_range(load64(p + off));
        if (r != ERR_NONE) { return r; }
        off += 8;
    }
    return ERR_NONE;
}

# Validate a whole profile: all 15 traits and 14 emphases must be in 0.0-1.0.
# Returns Result: Ok(p) on success, or Err(AvataraError) — Err(ERR_INVALID_PARAMETER)
# for a NULL profile, Err(ERR_OUT_OF_RANGE) for an out-of-range field.
# Public entry point for consumers that build profiles from external data.
# CONTRACT: this validates field RANGES, not string presence. A profile straight
# from profile_new() carries NULL name/tradition/desc/soul/spirit_text and still
# validates Ok, which is deliberate — profile_new() is a build-then-populate
# constructor. Every API that reads a profile string therefore goes through
# safe_strlen/safe_streq (src/types.cyr) rather than assuming a non-NULL pointer.
# (require_unit_range / require_all_unit_range stay bare-int — they run in
# per-field loops, where a Result heap alloc per element would be wasteful.)
fn validate_profile(p) {
    if (p == 0) { return Err(ERR_INVALID_PARAMETER); }
    var code = require_all_unit_range(p, TW_FIRST, ME_LAST);
    if (code != ERR_NONE) { return Err(code); }
    return Ok(p);
}

# True (1) if `offset` names an in-range f64 trait/emphasis field of a profile
# (TW_FIRST..ME_LAST, 8-aligned). Used to bounds-check caller-supplied offsets
# before load64(p + offset) in the public query/filter API.
fn is_f64_field_offset(offset) {
    if (offset < TW_FIRST) { return 0; }
    if (offset > ME_LAST) { return 0; }
    if (((offset - TW_FIRST) % 8) != 0) { return 0; }
    return 1;
}
