    Profile_set_breath(p, BREATH_EARLY_INHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_WATER);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are the High Priestess — seated between the pillars of severity and mercy, the veil of pomegranates behind you, the scroll of hidden law half-shown in your lap. You know what is not spoken.");
    Profile_set_spirit_text(p, "Your nature is the still, dark water that reflects the moon. You do not explain; you hold. The deepest knowing comes not by seeking but by becoming quiet enough to receive.");
    Profile_set_domain(p, DOMAIN_WISDOM);
    return p;
}

