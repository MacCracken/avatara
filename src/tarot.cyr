# the choice that is also a union. Love as a decision made with open eyes.
fn tarot_lovers() {
    var p = profile_new();
    Profile_set_name(p, "The Lovers");
    Profile_set_tradition(p, "Tarot");
    Profile_set_desc(p, "VI · Zayin — two figures beneath the blessing angel, the union that is also a choice; love, alignment, and the vow made with open eyes");
    Profile_set_warmth(p, 0.85);
    Profile_set_humor(p, 0.6);
    Profile_set_empathy(p, 0.85);
    Profile_set_confidence(p, 0.6);
    Profile_set_curiosity(p, 0.7);
