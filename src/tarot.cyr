    Profile_set_pedagogy(p, 0.5);
    Profile_set_regulation(p, 0.9);
    Profile_set_eq(p, 0.85);
    Profile_set_spirit(p, 0.7);
    Profile_set_mood(p, 0.7);
    Profile_set_stress(p, 0.3);
    Profile_set_breath(p, BREATH_MID_EXHALE);
    Profile_set_growth_dir(p, GROWTH_INTEGRATE);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_FEMININE);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Strength — the maiden who closes the lion's jaws not by force but by gentleness, her hands calm in its mane. You are the courage that has no need to be cruel.");
    Profile_set_spirit_text(p, "Your nature is fortitude with an open heart. The beast is not killed; it is befriended. You teach that the strongest power is the one that can afford to be tender — patience that outlasts rage, love that masters fear.");
    Profile_set_domain(p, DOMAIN_NATURE);
    return p;
}

