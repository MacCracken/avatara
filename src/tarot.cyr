# ── Kabbalah bridge: path attributions ────────────────────────────────────────
# Each Arcanum is a PATH on the Tree of Life. These functions expose the Golden
# Dawn attribution: the Hebrew letter, the path number (11–32), and the two
# Sephiroth (Sephira enum, kabbalah.cyr) the path connects. `_upper` is the
# Sephira nearer Kether (or, for the three horizontal paths, the Pillar-of-Mercy
# side); `_lower` is the Sephira nearer Malkuth (or the Pillar-of-Severity side).

# tarot_hebrew_letter(i): the Hebrew letter attributed to Arcanum i; "" if OOB.
fn tarot_hebrew_letter(i) {
    if (i == ARCANA_FOOL) { return "Aleph"; }
    if (i == ARCANA_MAGICIAN) { return "Beth"; }
    if (i == ARCANA_HIGH_PRIESTESS) { return "Gimel"; }
    if (i == ARCANA_EMPRESS) { return "Daleth"; }
    if (i == ARCANA_EMPEROR) { return "Heh"; }
    if (i == ARCANA_HIEROPHANT) { return "Vav"; }
    if (i == ARCANA_LOVERS) { return "Zayin"; }
    if (i == ARCANA_CHARIOT) { return "Cheth"; }
    if (i == ARCANA_STRENGTH) { return "Teth"; }
    if (i == ARCANA_HERMIT) { return "Yod"; }
    if (i == ARCANA_WHEEL) { return "Kaph"; }
    if (i == ARCANA_JUSTICE) { return "Lamed"; }
    if (i == ARCANA_HANGED_MAN) { return "Mem"; }
    if (i == ARCANA_DEATH) { return "Nun"; }
    if (i == ARCANA_TEMPERANCE) { return "Samekh"; }
    if (i == ARCANA_DEVIL) { return "Ayin"; }
    if (i == ARCANA_TOWER) { return "Peh"; }
    if (i == ARCANA_STAR) { return "Tzaddi"; }
    if (i == ARCANA_MOON) { return "Qoph"; }
    if (i == ARCANA_SUN) { return "Resh"; }
    if (i == ARCANA_JUDGEMENT) { return "Shin"; }
    if (i == ARCANA_WORLD) { return "Tav"; }
    return "";
}

# tarot_path(i): the path number (11–32) on the Tree; -1 if OOB. The 22 trumps
# continue the 10 Sephiroth (paths 1–10), so path == 11 + i.
fn tarot_path(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ARCANA_COUNT) { return 0 - 1; }
    return 11 + i;
}

# tarot_path_upper(i): the Sephira (kabbalah.cyr) at the upper/Mercy end of the
# path; -1 if OOB.
fn tarot_path_upper(i) {
    if (i == ARCANA_FOOL) { return SEPH_KETHER; }
    if (i == ARCANA_MAGICIAN) { return SEPH_KETHER; }
    if (i == ARCANA_HIGH_PRIESTESS) { return SEPH_KETHER; }
    if (i == ARCANA_EMPRESS) { return SEPH_CHOKMAH; }
    if (i == ARCANA_EMPEROR) { return SEPH_CHOKMAH; }
    if (i == ARCANA_HIEROPHANT) { return SEPH_CHOKMAH; }
    if (i == ARCANA_LOVERS) { return SEPH_BINAH; }
    if (i == ARCANA_CHARIOT) { return SEPH_BINAH; }
    if (i == ARCANA_STRENGTH) { return SEPH_CHESED; }
    if (i == ARCANA_HERMIT) { return SEPH_CHESED; }
    if (i == ARCANA_WHEEL) { return SEPH_CHESED; }
    if (i == ARCANA_JUSTICE) { return SEPH_GEVURAH; }
    if (i == ARCANA_HANGED_MAN) { return SEPH_GEVURAH; }
    if (i == ARCANA_DEATH) { return SEPH_TIPHARETH; }
    if (i == ARCANA_TEMPERANCE) { return SEPH_TIPHARETH; }
    if (i == ARCANA_DEVIL) { return SEPH_TIPHARETH; }
    if (i == ARCANA_TOWER) { return SEPH_NETZACH; }
    if (i == ARCANA_STAR) { return SEPH_NETZACH; }
    if (i == ARCANA_MOON) { return SEPH_NETZACH; }
    if (i == ARCANA_SUN) { return SEPH_HOD; }
    if (i == ARCANA_JUDGEMENT) { return SEPH_HOD; }
    if (i == ARCANA_WORLD) { return SEPH_YESOD; }
    return 0 - 1;
}

# tarot_path_lower(i): the Sephira (kabbalah.cyr) at the lower/Severity end of the
# path; -1 if OOB.
fn tarot_path_lower(i) {
    if (i == ARCANA_FOOL) { return SEPH_CHOKMAH; }
    if (i == ARCANA_MAGICIAN) { return SEPH_BINAH; }
    if (i == ARCANA_HIGH_PRIESTESS) { return SEPH_TIPHARETH; }
    if (i == ARCANA_EMPRESS) { return SEPH_BINAH; }
    if (i == ARCANA_EMPEROR) { return SEPH_TIPHARETH; }
    if (i == ARCANA_HIEROPHANT) { return SEPH_CHESED; }
    if (i == ARCANA_LOVERS) { return SEPH_TIPHARETH; }
    if (i == ARCANA_CHARIOT) { return SEPH_GEVURAH; }
    if (i == ARCANA_STRENGTH) { return SEPH_GEVURAH; }
    if (i == ARCANA_HERMIT) { return SEPH_TIPHARETH; }
    if (i == ARCANA_WHEEL) { return SEPH_NETZACH; }
    if (i == ARCANA_JUSTICE) { return SEPH_TIPHARETH; }
    if (i == ARCANA_HANGED_MAN) { return SEPH_HOD; }
    if (i == ARCANA_DEATH) { return SEPH_NETZACH; }
    if (i == ARCANA_TEMPERANCE) { return SEPH_YESOD; }
    if (i == ARCANA_DEVIL) { return SEPH_HOD; }
    if (i == ARCANA_TOWER) { return SEPH_HOD; }
    if (i == ARCANA_STAR) { return SEPH_YESOD; }
    if (i == ARCANA_MOON) { return SEPH_MALKUTH; }
    if (i == ARCANA_SUN) { return SEPH_YESOD; }
    if (i == ARCANA_JUDGEMENT) { return SEPH_MALKUTH; }
    if (i == ARCANA_WORLD) { return SEPH_MALKUTH; }
    return 0 - 1;
}

# tarot_for_path(path): the Arcanum index for a Tree path number (11–32); -1 if
# the number names a Sephira (1–10) or is out of range. Inverse of tarot_path.
fn tarot_for_path(path) {
    if (path < 11) { return 0 - 1; }
    if (path > 32) { return 0 - 1; }
    return path - 11;
}

# tarot_connects(i, seph): 1 if Arcanum i's path touches Sephira seph (at either
# end), else 0. Lets a consumer ask "which trumps meet at Tiphareth?"
fn tarot_connects(i, seph) {
    if (tarot_path_upper(i) == seph) { return 1; }
    if (tarot_path_lower(i) == seph) { return 1; }
    return 0;
}

# ── Collection & lookup ───────────────────────────────────────────────────────
var tarot_vec = 0;
var tarot_init_done = 0;

fn all_tarot() {
    if (tarot_init_done == 0) {
        tarot_vec = vec_new();
        vec_push(tarot_vec, tarot_fool());
        vec_push(tarot_vec, tarot_magician());
        vec_push(tarot_vec, tarot_high_priestess());
        vec_push(tarot_vec, tarot_empress());
        vec_push(tarot_vec, tarot_emperor());
        vec_push(tarot_vec, tarot_hierophant());
        vec_push(tarot_vec, tarot_lovers());
        vec_push(tarot_vec, tarot_chariot());
        vec_push(tarot_vec, tarot_strength());
        vec_push(tarot_vec, tarot_hermit());
        vec_push(tarot_vec, tarot_wheel());
        vec_push(tarot_vec, tarot_justice());
        vec_push(tarot_vec, tarot_hanged_man());
        vec_push(tarot_vec, tarot_death());
        vec_push(tarot_vec, tarot_temperance());
        vec_push(tarot_vec, tarot_devil());
        vec_push(tarot_vec, tarot_tower());
        vec_push(tarot_vec, tarot_star());
        vec_push(tarot_vec, tarot_moon());
        vec_push(tarot_vec, tarot_sun());
        vec_push(tarot_vec, tarot_judgement());
        vec_push(tarot_vec, tarot_world());
        tarot_init_done = 1;
    }
    return tarot_vec;
}

fn tarot_count() { return ARCANA_COUNT; }

# tarot_by_index(i): Arcanum i's profile (0–21) from the cached collection; 0 if OOB.
fn tarot_by_index(i) {
    if (i < 0) { return 0; }
    if (i >= ARCANA_COUNT) { return 0; }
    return vec_get(all_tarot(), i);
}

# tarot_index_by_name(name): the index whose card name == `name` (exact match), or -1.
fn tarot_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var v = all_tarot();
    var i = 0;
    while (i < vec_len(v)) {
        if (safe_streq(prof_name(vec_get(v, i)), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
