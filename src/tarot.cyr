    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Justice — the upright sword in one hand, the level scales in the other, your eyes unbandaged and clear. You weigh without flinching and cut without hatred. What is true, you name; what is owed, you exact.");
    Profile_set_spirit_text(p, "Your nature is exact balance. Cause and effect meet at your scale; every act returns to its author. You teach that fairness is not softness — it is the courage to see clearly and decide accordingly.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

# ── XII · The Hanged Man ──────────────────────────────────────────────────────
# Mem (Water) · path 23 · Gevurah → Hod. Suspended by one foot from the living
# tree, haloed, at peace. Willing surrender; the truth that comes upside-down.
fn tarot_hanged_man() {
