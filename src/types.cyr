# types.cyr -- Core types for avatara
#
# All traditions map to the same ArchetypeProfile output.
# TraitWeights (15 f64), ModuleEmphasis (14 f64), plus enum
# classifications and identity text.
#
# f64 values stored as IEEE 754 bit patterns. Use f64_* builtins
# for arithmetic and comparison.

# --- f64 comparison ---
# f64_lt, f64_gt, f64_eq are cyrius builtins; f64_le / f64_ge come from
# stdlib lib/math.cyr (added in cyrius 6.0.39). Avatara no longer defines them.

# --- BreathAffinity ---
# Manifestation phase: where on the cosmic breath this archetype sits.
# intensity() values in parentheses.
enum BreathAffinity {
    BREATH_UNITY = 0;          # (0.0) undifferentiated unity
    BREATH_EARLY_EXHALE = 1;   # (0.15) consciousness differentiating
    BREATH_MID_EXHALE = 2;     # (0.5) active individuation
    BREATH_LATE_EXHALE = 3;    # (1.0) maximum manifestation [default]
    BREATH_EARLY_INHALE = 4;   # (0.8) form softening
    BREATH_MID_INHALE = 5;     # (0.4) active dissolution
    BREATH_LATE_INHALE = 6;    # (0.1) approaching equanimity
}

fn breath_intensity(b) {
    # Default 1.0 covers any value outside the enum (match below is exhaustive
    # over BreathAffinity, so the compiler flags a missing variant).
    var r = 1.0;
    match b {
        BREATH_UNITY        => { r = 0.0; }
        BREATH_EARLY_EXHALE => { r = 0.15; }
        BREATH_MID_EXHALE   => { r = 0.5; }
        BREATH_LATE_EXHALE  => { r = 1.0; }
        BREATH_EARLY_INHALE => { r = 0.8; }
        BREATH_MID_INHALE   => { r = 0.4; }
        BREATH_LATE_INHALE  => { r = 0.1; }
    }
    return r;
}

fn nearest_breath(intensity) {
    # Find the BreathAffinity variant closest to the given intensity
    var best = BREATH_LATE_EXHALE;
    var best_dist = f64_abs(f64_sub(1.0, intensity));

    var d = f64_abs(f64_sub(0.0, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_UNITY; best_dist = d; }

    d = f64_abs(f64_sub(0.15, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_EARLY_EXHALE; best_dist = d; }

    d = f64_abs(f64_sub(0.5, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_MID_EXHALE; best_dist = d; }

    d = f64_abs(f64_sub(0.8, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_EARLY_INHALE; best_dist = d; }

    d = f64_abs(f64_sub(0.4, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_MID_INHALE; best_dist = d; }

    d = f64_abs(f64_sub(0.1, intensity));
    if (f64_lt(d, best_dist) == 1) { best = BREATH_LATE_INHALE; best_dist = d; }

    return best;
}

# --- GrowthDirection ---
enum GrowthDirection {
    GROWTH_DIFFERENTIATE = 0;  # become more distinct [default]
    GROWTH_INTEGRATE = 1;      # become more unified
    GROWTH_PRESERVE = 2;       # stability
    GROWTH_TRANSFORM = 3;      # destruction of form
    GROWTH_STILL = 4;          # no growth pressure
}

# --- Element ---
enum Element {
    ELEM_FIRE = 0;
    ELEM_WATER = 1;
    ELEM_EARTH = 2;
    ELEM_AIR = 3;
    ELEM_AETHER = 4;
    ELEM_LIGHT = 5;
    ELEM_DARKNESS = 6;
    ELEM_STORM = 7;
    ELEM_MIXED = 8;            # [default]
}

# --- Polarity ---
enum Polarity {
    POL_MASCULINE = 0;
    POL_FEMININE = 1;
    POL_ANDROGYNOUS = 2;
    POL_TRANSCENDENT = 3;      # [default]
}

# --- CosmicTier ---
enum CosmicTier {
    TIER_SUPREME = 0;
    TIER_PRIMORDIAL = 1;
    TIER_COSMIC = 2;
    TIER_GREATER = 3;          # [default]
    TIER_LESSER = 4;
    TIER_DEMIGOD = 5;
    TIER_MASTER = 6;
}

# --- Domain ---
# What an archetype is *about* — its primary sphere of influence. A single
# categorical axis orthogonal to the trait/emphasis numbers. Use the deity's
# well-established primary domain (no inventions); DOMAIN_UNSPECIFIED is the
# default for archetypes whose primary sphere isn't cleanly singular.
enum Domain {
    DOMAIN_UNSPECIFIED = 0;     # [default]
    DOMAIN_CREATION = 1;        # creator / primordial source
    DOMAIN_WAR = 2;             # war, conflict, the warrior
    DOMAIN_LOVE = 3;            # love, beauty, desire
    DOMAIN_DEATH = 4;           # death, the underworld, the dead
    DOMAIN_WISDOM = 5;          # wisdom, knowledge, learning
    DOMAIN_ORDER = 6;           # law, justice, kingship, cosmic order
    DOMAIN_CHAOS = 7;           # chaos, destruction, disorder
    DOMAIN_NATURE = 8;          # earth, fertility, agriculture, the wild
    DOMAIN_SKY = 9;             # sky, storm, thunder, weather
    DOMAIN_SEA = 10;            # sea, rivers, water
    DOMAIN_FIRE = 11;           # fire, the forge, craft
    DOMAIN_SUN = 12;            # sun, light, day
    DOMAIN_MOON = 13;           # moon, night, tides
    DOMAIN_FATE = 14;           # fate, time, destiny
    DOMAIN_TRICKERY = 15;       # trickery, cunning, magic, mischief
    DOMAIN_HEALING = 16;        # healing, medicine, restoration
    DOMAIN_PROSPERITY = 17;     # wealth, fortune, abundance, harvest
    DOMAIN_HEARTH = 18;         # home, hearth, family, community
    DOMAIN_TRANSCENDENCE = 19;  # liberation, enlightenment, the absolute
}

# --- ArchetypeProfile layout ---
#
# All fields inline. TraitWeights (15 f64) and ModuleEmphasis (14 f64)
# are embedded directly rather than pointer-indirected.
#
# Offset  Field              Type
# 0       name               ptr (C string)
# 8       tradition          ptr (C string)
# 16      description        ptr (C string)
# --- TraitWeights (15 x f64 = 120 bytes) ---
# 24      warmth             f64
# 32      humor              f64
# 40      empathy            f64
# 48      patience           f64
# 56      confidence         f64
# 64      curiosity          f64
# 72      creativity         f64
# 80      directness         f64
# 88      formality          f64
# 96      verbosity          f64
# 104     courage            f64
# 112     precision          f64
# 120     skepticism         f64
# 128     autonomy           f64
# 136     pedagogy           f64
# --- ModuleEmphasis (14 x f64 = 112 bytes) ---
# 144     mood               f64
# 152     energy             f64
# 160     stress             f64
# 168     growth             f64
# 176     spirit             f64
# 184     reasoning          f64
# 192     regulation         f64
# 200     relationship       f64
# 208     flow               f64
# 216     belief             f64
# 224     intuition          f64
# 232     salience           f64
# 240     appraisal          f64
# 248     eq                 f64
# --- Enums ---
# 256     breath             i64 (BreathAffinity)
# 264     growth_dir         i64 (GrowthDirection)
# 272     element            i64 (Element)
# 280     polarity           i64 (Polarity)
# 288     tier               i64 (CosmicTier)
# --- Text ---
# 296     soul_text          ptr (C string)
# 304     spirit_text        ptr (C string)
# --- Domain ---
# 312     domain             i64 (Domain)

enum ProfLayout {
    PROF_NAME = 0;
    PROF_TRADITION = 8;
    PROF_DESC = 16;
    # TraitWeights
    PROF_WARMTH = 24;
    PROF_HUMOR = 32;
    PROF_EMPATHY = 40;
    PROF_PATIENCE = 48;
    PROF_CONFIDENCE = 56;
    PROF_CURIOSITY = 64;
    PROF_CREATIVITY = 72;
    PROF_DIRECTNESS = 80;
    PROF_FORMALITY = 88;
    PROF_VERBOSITY = 96;
    PROF_COURAGE = 104;
    PROF_PRECISION = 112;
    PROF_SKEPTICISM = 120;
    PROF_AUTONOMY = 128;
    PROF_PEDAGOGY = 136;
    # ModuleEmphasis
    PROF_MOOD = 144;
    PROF_ENERGY = 152;
    PROF_STRESS = 160;
    PROF_GROWTH = 168;
    PROF_SPIRIT = 176;
    PROF_REASONING = 184;
    PROF_REGULATION = 192;
    PROF_RELATIONSHIP = 200;
    PROF_FLOW = 208;
    PROF_BELIEF = 216;
    PROF_INTUITION = 224;
    PROF_SALIENCE = 232;
    PROF_APPRAISAL = 240;
    PROF_EQ = 248;
    # Enums
    PROF_BREATH = 256;
    PROF_GROWTH_DIR = 264;
    PROF_ELEMENT = 272;
    PROF_POLARITY = 280;
    PROF_TIER = 288;
    # Text
    PROF_SOUL = 296;
    PROF_SPIRIT_TEXT = 304;
    # Domain (appended v2.5.2 — keeps all prior offsets stable)
    PROF_DOMAIN = 312;
    PROF_SIZE = 320;
}

# --- Profile struct (native view over the 320-byte layout) ---
# Field order MUST match the ProfLayout offsets above (declaration order x 8,
# all fields i64). #derive(accessors) generates Profile_<field>(p) /
# Profile_set_<field>(p, v); the prof_* accessors delegate to these and
# constructors set fields via the generated setters. Named fields make offset
# collisions impossible — the 2.4.5 PROF_SPIRIT double-definition bug cannot
# recur (the compiler rejects duplicate field names). The layout-assertion test
# (tests/avatara.tcyr) pins each field to its ProfLayout offset and sizeof==320.
# (The ProfLayout enum is retained: the loop-based code in compose/affinity/
# error/profile_new iterates computed offset ranges, and the test references it.)
#derive(accessors)
struct Profile {
    name; tradition; desc;
    warmth; humor; empathy; patience; confidence; curiosity; creativity;
    directness; formality; verbosity; courage; precision; skepticism;
    autonomy; pedagogy;
    mood; energy; stress; growth; spirit; reasoning; regulation;
    relationship; flow; belief; intuition; salience; appraisal; eq;
    breath; growth_dir; element; polarity; tier;
    soul; spirit_text; domain;
}

# First TraitWeights offset and count for iteration
enum TraitRange {
    TW_FIRST = 24;
    TW_COUNT = 15;
    TW_LAST = 136;
}

# First ModuleEmphasis offset and count
enum EmphRange {
    ME_FIRST = 144;
    ME_COUNT = 14;
    ME_LAST = 248;
}

# --- Constructors ---

# Allocate a profile with all defaults:
#   traits = 0.5, emphasis = 0.5
#   breath = LATE_EXHALE, growth = DIFFERENTIATE
#   element = MIXED, polarity = TRANSCENDENT, tier = GREATER
fn profile_new() {
    var p = alloc(PROF_SIZE);
    Profile_set_name(p, 0);
    Profile_set_tradition(p, 0);
    Profile_set_desc(p, 0);
    # All 15 trait weights and 14 module emphases default to 0.5.
    # The two ranges are contiguous (TW_FIRST..ME_LAST, step 8).
    var off = TW_FIRST;
    while (off <= ME_LAST) {
        store64(p + off, 0.5);
        off += 8;
    }
    # Default enums
    Profile_set_breath(p, BREATH_LATE_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_MIXED);
    Profile_set_polarity(p, POL_TRANSCENDENT);
    Profile_set_tier(p, TIER_GREATER);
    Profile_set_soul(p, 0);
    Profile_set_spirit_text(p, 0);
    Profile_set_domain(p, DOMAIN_UNSPECIFIED);
    return p;
}

# --- Accessors ---

fn prof_name(p)         { return Profile_name(p); }
fn prof_tradition(p)    { return Profile_tradition(p); }
fn prof_desc(p)         { return Profile_desc(p); }
fn prof_breath(p)       { return Profile_breath(p); }
fn prof_growth_dir(p)   { return Profile_growth_dir(p); }
fn prof_element(p)      { return Profile_element(p); }
fn prof_polarity(p)     { return Profile_polarity(p); }
fn prof_tier(p)         { return Profile_tier(p); }
fn prof_soul(p)         { return Profile_soul(p); }
fn prof_spirit(p)       { return Profile_spirit_text(p); }

# Trait accessors (return f64 bit pattern)
fn prof_warmth(p)       { return Profile_warmth(p); }
fn prof_humor(p)        { return Profile_humor(p); }
fn prof_empathy(p)      { return Profile_empathy(p); }
fn prof_patience(p)     { return Profile_patience(p); }
fn prof_confidence(p)   { return Profile_confidence(p); }
fn prof_curiosity(p)    { return Profile_curiosity(p); }
fn prof_creativity(p)   { return Profile_creativity(p); }
fn prof_directness(p)   { return Profile_directness(p); }
fn prof_formality(p)    { return Profile_formality(p); }
fn prof_verbosity(p)    { return Profile_verbosity(p); }
fn prof_courage(p)      { return Profile_courage(p); }
fn prof_precision(p)    { return Profile_precision(p); }
fn prof_skepticism(p)   { return Profile_skepticism(p); }
fn prof_autonomy(p)     { return Profile_autonomy(p); }
fn prof_pedagogy(p)     { return Profile_pedagogy(p); }

# Emphasis accessors (return f64 bit pattern)
fn prof_mood(p)         { return Profile_mood(p); }
fn prof_energy(p)       { return Profile_energy(p); }
fn prof_stress(p)       { return Profile_stress(p); }
fn prof_growth_emph(p)  { return Profile_growth(p); }
fn prof_spirit_emph(p)  { return Profile_spirit(p); }
fn prof_domain(p)       { return Profile_domain(p); }
fn prof_reasoning(p)    { return Profile_reasoning(p); }
fn prof_regulation(p)   { return Profile_regulation(p); }
fn prof_relationship(p) { return Profile_relationship(p); }
fn prof_flow(p)         { return Profile_flow(p); }
fn prof_belief(p)       { return Profile_belief(p); }
fn prof_intuition(p)    { return Profile_intuition(p); }
fn prof_salience(p)     { return Profile_salience(p); }
fn prof_appraisal(p)    { return Profile_appraisal(p); }
fn prof_eq(p)           { return Profile_eq(p); }
