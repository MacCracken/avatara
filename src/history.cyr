        "Founded by Guru Nanak (1469) in the Punjab during Mughal rule; ten Gurus shaped theology, scripture (Guru Granth Sahib), and martial tradition (Khalsa, 1699); living tradition with 30 million adherents"));

        vec_push(history_vec, history_map_new("Incarnate Hindu", "Indus Valley",
        svec2("Indus Valley", "Maratha Empire"), svec3("Vedic Period", "Gupta Period", "Mughal Period"),
        (0-500), LIVING,
        "Hindu saints, yogis, and reformers -- incarnate masters who shaped living Hinduism from Adi Shankara through Ramakrishna and Vivekananda"));

        vec_push(history_vec, history_map_new("Incarnate Buddhist", "Indus Valley",
        svec2("Indus Valley", "Ancient China"), svec2("Maurya Period", "Tang Dynasty"),
        (0-300), LIVING,
        "Buddhist masters who transmitted dharma across Asia -- Nagarjuna, Bodhidharma, Padmasambhava, Milarepa -- bridging Indian origins with Chinese, Tibetan, and Japanese forms"));

        vec_push(history_vec, history_map_new("Incarnate Mystic", "Persian Empire",
        svec2("Persian Empire", "Ottoman Empire"), svec1("Middle Ages"),
        800, LIVING,
        "Sufi and cross-tradition mystics -- Rumi, Ibn Arabi, Kabir, Meister Eckhart -- who transcended sectarian boundaries to articulate direct experiential union with the divine"));

        vec_push(history_vec, history_map_new("Incarnate Taoist", "Ancient China",
        svec1("Ancient China"), svec3("Han Dynasty", "Tang Dynasty", "Song Dynasty"),
        (0-400), LIVING,
        "Taoist sages and alchemists -- Zhang Daoling, Ge Hong, Sun Simiao -- who developed inner alchemy, medicine, and monastic traditions"));

        vec_push(history_vec, history_map_new("Comanche", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1700, LIVING,
        "The Comanche (Numunuu) separated from the Eastern Shoshone and moved onto the southern plains in the early 1700s, becoming the dominant horse power of the region; Quanah Parker, the last war chief of the Quahada band, later led the move to reservation life and was a founding figure of the Native American Church"));

        vec_push(history_vec, history_map_new("Northern Paiute", "Great Basin",
        svec1("Great Basin"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "The Northern Paiute (Numu) of the Great Basin; Wovoka received in 1889 the vision that became the Ghost Dance, which spread across the plains within a year and was met with the suppression that ended at Wounded Knee in 1890"));

        vec_push(history_vec, history_map_new("Incarnate Sage", "Ancient Greece",
        svec2("Ancient Greece", "Ancient China"), svec2("Classical Antiquity", "Zhou Dynasty"),
        (0-600), LIVING,
        "Philosopher-sages of the Axial Age and beyond -- Pythagoras, Socrates, Confucius -- who laid the foundations of rational and ethical inquiry"));

        vec_push(history_vec, history_map_new("Finnish", "Viking/Norse",
        svec1("Viking/Norse"), svec2("Iron Age", "Middle Ages"),
        (0-1000), LIVING,
        "Finnish and Sami spiritual traditions preserved in the Kalevala (compiled 1835 by Elias Lonnrot from oral tradition) and Sami shamanic practice; Vainamoinen, Ukko, and Tapio reflect Uralic cosmology distinct from but parallel to Norse mythology"));

        vec_push(history_vec, history_map_new("Vodou", "Ghana Empire",
        svec2("Ghana Empire", "Songhai Empire"), svec1("Middle Ages"),
        1600, LIVING,
        "Haitian Vodou synthesized West African (primarily Fon and Yoruba) spiritual traditions with Taino and Catholic elements during the colonial period; a living religion of the African diaspora, central to the Haitian Revolution (1791-1804) and Haitian national identity"));

        vec_push(history_vec, history_map_new("Tarot", "Renaissance Italy",
        svec3("Renaissance Italy", "Kingdom of France", "British Empire"), svec2("Renaissance", "Modern"),
        1440, LIVING,
        "The Major Arcana appear as the trump suit of 15th-century Italian tarocchi (Visconti-Sforza decks, c. 1440s Milan); the esoteric reading was developed by Court de Gebelin (1781) and Eliphas Levi, who first mapped the 22 trumps to the 22 Hebrew letters and the Kabbalah, and systematized by the Hermetic Order of the Golden Dawn (1888) into the Tree-of-Life path attributions used here; the Rider-Waite-Smith deck (1909) fixed the modern imagery. A living divinatory and initiatory tradition"));

        vec_push(history_vec, history_map_new("I Ching", "Ancient China",
        svec1("Ancient China"), svec3("Zhou Dynasty", "Han Dynasty", "Song Dynasty"),
        (0-1000), LIVING,
        "The Zhou Yi, oldest of the Chinese classics: its sixty-four hexagram texts were compiled in the Western Zhou (c. 1000-750 BCE) out of a much older milfoil divination practice; the Ten Wings commentaries (Warring States through Han) made it the first of the Five Classics and the shared cosmological root of both Confucian and Taoist thought, and the Song Neo-Confucians (Zhu Xi) reworked it again; still consulted as both oracle and philosophical text"));

        vec_push(history_vec, history_map_new("Inuit", "Inuit Nunangat",
        svec2("Inuit Nunangat", "Greenland"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "Thule culture, ancestral to today's Inuit, spread east from Alaska across the Arctic around 1000 CE, carrying the cosmology later recorded by Franz Boas and Knud Rasmussen; a living tradition across Inuit Nunangat, Greenland and Alaska, articulated today as Inuit Qaujimajatuqangit"));

        vec_push(history_vec, history_map_new("Lakota", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1500, LIVING,
        "The Lakota, westernmost of the Oceti Sakowin (Seven Council Fires), moved from the woodlands onto the northern plains and, with the horse from the early 1700s, became its dominant people; the cosmology was systematized in print in the early 20th century and is carried in living ceremony -- the Sun Dance and the seven rites of the chanunpa"));

        vec_push(history_vec, history_map_new("Haudenosaunee", "Northeastern Woodlands",
        svec1("Northeastern Woodlands"), svec2("Middle Ages", "Modern"),
        1142, LIVING,
        "The Confederacy of five nations -- Mohawk, Oneida, Onondaga, Cayuga, Seneca -- joined by the Tuscarora in 1722; its founding is dated anywhere from 1142 to the late 1500s depending on the source, and it persists as a governing body. The Sky Woman creation account and the Great Law of Peace have been taught continuously"));

        vec_push(history_vec, history_map_new("Anishinaabe", "Great Lakes",
        svec1("Great Lakes"), svec2("Middle Ages", "Modern"),
        900, LIVING,
        "Ojibwe, Odawa and Potawatomi -- the Council of Three Fires. The migration west from the eastern seaboard to the Great Lakes is recorded in the Seven Fires oral history and on the birchbark scrolls of the Midewiwin as set down by Edward Benton-Banai in *The Mishomis Book*; a living tradition across the Great Lakes and the northern plains"));

        vec_push(history_vec, history_map_new("Aboriginal Australian", "Aboriginal Australia",
        svec1("Aboriginal Australia"), svec2("Deep Time", "Modern"),
        (0-65000), LIVING,
        "Aboriginal Australians have occupied the continent for at least 65,000 years, the longest continuous living cultures on earth, across 250+ nations with distinct languages and Law; there is no shared pantheon and the Dreaming is not a past era but an ongoing reality. The figures carried here are limited to those established in public, community-involved material"));

        history_init_done = 1;
    }
    return history_vec;
}

fn mapping_count() { return vec_len(all_mappings()); }

# --- Query functions ---

# Find the mapping for a tradition name. Returns mapping ptr or 0.
fn find_mapping(tradition) {
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (streq(map_tradition(m), tradition) == 1) { return m; }
    }
    return 0;
}

# Get historical context for a tradition. Returns HistoricalContext ptr or 0.
fn context_for_tradition(tradition) {
    var m = find_mapping(tradition);
    if (m == 0) { return 0; }
    var c = xalloc(CTX_SIZE);
    store64(c + CTX_PRIMARY_CIV, map_primary(m));
    store64(c + CTX_CIV_NAMES, map_civs(m));
    store64(c + CTX_ERA_NAMES, map_eras(m));
    store64(c + CTX_START_YEAR, map_start(m));
    store64(c + CTX_END_YEAR, map_end(m));
    store64(c + CTX_NOTE, map_note(m));
    return c;
}

# Get historical context for a profile (by its tradition field).
fn context_for_profile(profile) {
    return context_for_tradition(prof_tradition(profile));
}

# List all tradition names that have historical mappings.
fn mapped_traditions() {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        vec_push(result, map_tradition(vec_get(v, i)));
    }
    return result;
}

# Find all traditions associated with a given civilization name.
fn traditions_for_civilization(civ_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var civs = map_civs(m);
        var cn = vec_len(civs);
        for (var j = 0; j < cn; j += 1) {
            if (streq(vec_get(civs, j), civ_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions active during a given year.
fn traditions_active_at(year) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (map_start(m) <= year) {
            if (year <= map_end(m)) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions associated with a given era name.
fn traditions_for_era(era_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var eras = map_eras(m);
        var en = vec_len(eras);
        for (var j = 0; j < en; j += 1) {
            if (streq(vec_get(eras, j), era_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}
