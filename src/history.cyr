# history.cyr -- Historical context integration
#
# Maps avatara traditions to their civilizational and temporal context,
# grounding divine archetypes in the historical reality where they emerged.
# Each tradition maps to one or more civilizations, eras, and a temporal
# range — the period during which the tradition's theology was actively forming.
#
# 37 tradition-to-history mappings with scholarly historical notes.

# --- TraditionMapping layout ---
# Each mapping: tradition name, primary civ, civ names (vec), era names (vec),
# start year, end year, historical note.
enum MapLayout {
    MAP_TRADITION = 0;
    MAP_PRIMARY_CIV = 8;
    MAP_CIV_NAMES = 16;
    MAP_ERA_NAMES = 24;
    MAP_START_YEAR = 32;
    MAP_END_YEAR = 40;
    MAP_NOTE = 48;
    MAP_SIZE = 56;
}

# i32::MAX equivalent for "living tradition"
enum HistConst { LIVING = 2147483647; }

fn history_map_new(tradition, primary_civ, civs, eras, start, end, note) {
    var m = xalloc(MAP_SIZE);
    store64(m + MAP_TRADITION, tradition);
    store64(m + MAP_PRIMARY_CIV, primary_civ);
    store64(m + MAP_CIV_NAMES, civs);
    store64(m + MAP_ERA_NAMES, eras);
    store64(m + MAP_START_YEAR, start);
    store64(m + MAP_END_YEAR, end);
    store64(m + MAP_NOTE, note);
    return m;
}

fn map_tradition(m)   { return load64(m + MAP_TRADITION); }
fn map_primary(m)     { return load64(m + MAP_PRIMARY_CIV); }
fn map_civs(m)        { return load64(m + MAP_CIV_NAMES); }
fn map_eras(m)        { return load64(m + MAP_ERA_NAMES); }
fn map_start(m)       { return load64(m + MAP_START_YEAR); }
fn map_end(m)         { return load64(m + MAP_END_YEAR); }
fn map_note(m)        { return load64(m + MAP_NOTE); }

# --- HistoricalContext layout ---
enum CtxLayout {
    CTX_PRIMARY_CIV = 0;
    CTX_CIV_NAMES = 8;
    CTX_ERA_NAMES = 16;
    CTX_START_YEAR = 24;
    CTX_END_YEAR = 32;
    CTX_NOTE = 40;
    CTX_SIZE = 48;
}

fn ctx_primary(c)     { return load64(c + CTX_PRIMARY_CIV); }
fn ctx_civs(c)        { return load64(c + CTX_CIV_NAMES); }
fn ctx_eras(c)        { return load64(c + CTX_ERA_NAMES); }
fn ctx_start(c)       { return load64(c + CTX_START_YEAR); }
fn ctx_end(c)         { return load64(c + CTX_END_YEAR); }
fn ctx_note(c)        { return load64(c + CTX_NOTE); }

# --- Helper: build a vec of strings ---
fn svec1(a) { var v = vec_new(); vec_push(v, a); return v; }
fn svec2(a, b) { var v = vec_new(); vec_push(v, a); vec_push(v, b); return v; }
fn svec3(a, b, c) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); return v; }
fn svec4(a, b, c, d) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); return v; }
fn svec5(a, b, c, d, e) { var v = vec_new(); vec_push(v, a); vec_push(v, b); vec_push(v, c); vec_push(v, d); vec_push(v, e); return v; }

# --- Build all 37 mappings ---

var history_vec = 0;
var history_init_done = 0;

fn all_mappings() {
    if (history_init_done == 0) {
        history_vec = vec_new();

        vec_push(history_vec, history_map_new("Kabbalah", "Medieval Iberia",
        svec3("Judea", "Medieval Iberia", "Ottoman Empire"), svec2("Middle Ages", "Renaissance"),
        100, LIVING,
        "Rooted in Jewish mysticism from the 1st century CE, flourishing in medieval Provence and Spain (Zohar, 13th c.), with continued development through Lurianic Kabbalah in 16th c. Safed"));

        vec_push(history_vec, history_map_new("Angelic", "Phoenicia",
        svec2("Phoenicia", "Byzantine Empire"), svec2("Classical Antiquity", "Middle Ages"),
        (0-600), LIVING,
        "Angelology developed across Jewish, Christian, and Islamic traditions; systematized by Pseudo-Dionysius (5th c.) and elaborated through medieval scholasticism"));

        vec_push(history_vec, history_map_new("Hindu", "Indus Valley",
        svec3("Indus Valley", "Vijayanagara Empire", "Maratha Empire"), svec4("Vedic Period", "Maurya Period", "Gupta Period", "Mughal Period"),
        (0-1500), LIVING,
        "From Vedic hymns (c. 1500 BCE) through the epics and Puranas, with theological elaboration across Maurya, Gupta, and medieval kingdoms; living tradition with over a billion practitioners"));

        vec_push(history_vec, history_map_new("Greek", "Ancient Greece",
        svec2("Ancient Greece", "Roman Empire"), svec1("Classical Antiquity"),
        (0-800), 400,
        "Olympian religion shaped by Homeric epics (8th c. BCE), formalized in city-state cult practice, absorbed into Roman syncretism, and declined with Christianization of the empire"));

        vec_push(history_vec, history_map_new("Norse", "Viking/Norse",
        svec1("Viking/Norse"), svec1("Middle Ages"),
        200, 1100,
        "Germanic-Norse mythology recorded in the Eddas (13th c.) but reflecting traditions from the Migration Period through the Viking Age; displaced by Christianization of Scandinavia"));

        vec_push(history_vec, history_map_new("Egyptian", "Ancient Egypt",
        svec1("Ancient Egypt"), svec3("Bronze Age", "Iron Age", "Classical Antiquity"),
        (0-3100), 400,
        "Among the longest-lived religious traditions -- from predynastic nomes through the Ptolemaic period, with theology evolving across Old, Middle, and New Kingdoms over three millennia"));

        vec_push(history_vec, history_map_new("Buddhist", "Indus Valley",
        svec3("Indus Valley", "Ancient China", "Khmer Empire"), svec4("Maurya Period", "Gupta Period", "Han Dynasty", "Tang Dynasty"),
        (0-500), LIVING,
        "Founded by Siddhartha Gautama (5th c. BCE) in the Gangetic plain, spread under Ashoka's Maurya Empire, diversified into Mahayana and Vajrayana across East and Southeast Asia"));

        vec_push(history_vec, history_map_new("Mesopotamian", "Mesopotamia",
        svec2("Mesopotamia", "Assyrian Empire"), svec2("Bronze Age", "Iron Age"),
        (0-3500), (0-500),
        "Sumerian, Akkadian, and Babylonian religion -- among humanity's earliest recorded theologies, from Uruk-period temples through the Neo-Babylonian Empire; displaced by Persian and Hellenistic religions"));

        vec_push(history_vec, history_map_new("Celtic", "Gaelic Ireland",
        svec3("Gaelic Ireland", "Medieval Wales", "Gaul"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-800), 1200,
        "Continental and Insular Celtic religion, from Hallstatt culture through La Tene and Irish/Welsh medieval literary traditions; Tuatha De Danann preserved in the Lebor Gabala Erenn"));

        vec_push(history_vec, history_map_new("Shinto", "Tokugawa Shogunate",
        svec1("Tokugawa Shogunate"), svec2("Classical Antiquity", "Middle Ages"),
        (0-300), LIVING,
        "Indigenous Japanese spirituality formalized in the Kojiki (712 CE) and Nihon Shoki (720 CE); coexists with Buddhism through shinbutsu-shugo; living tradition integral to Japanese culture"));

        vec_push(history_vec, history_map_new("Aztec", "Aztec Empire",
        svec2("Aztec Empire", "Olmec"), svec1("Mesoamerican Postclassic"),
        1300, 1521,
        "Mexica theology synthesizing Toltec heritage with original cosmology, centered on Tenochtitlan; the Mexica state fell to the Spanish conquest in 1521, though Nahua peoples and their descendants continue, and elements of the tradition persist in contemporary Nahua practice"));

        vec_push(history_vec, history_map_new("Maya", "Maya",
        svec1("Maya"), svec3("Mesoamerican Preclassic", "Mesoamerican Classic", "Mesoamerican Postclassic"),
        (0-2000), LIVING,
        "One of the longest-lived Mesoamerican traditions, from Preclassic origins through Classic period city-states (Tikal, Palenque, Copan) to Postclassic Yucatan; Popol Vuh recorded in the colonial period. A living tradition: the last independent Maya polity, Itza Nojpeten, fell only in 1697, and the 260-day count (cholq\'ij) has been kept without interruption by highland aj q\'ij daykeepers into the present"));

        vec_push(history_vec, history_map_new("Yoruba", "Ife",
        svec2("Ife", "Oyo Empire"), svec1("Middle Ages"),
        (0-500), LIVING,
        "Ifa theology originating in Ile-Ife (present-day Nigeria), with oral tradition stretching back millennia; diaspora traditions (Candomble, Santeria, Vodun) carry it worldwide"));

        vec_push(history_vec, history_map_new("Zoroastrian", "Persian Empire",
        svec3("Persian Empire", "Sassanid Empire", "Parthian Empire"), svec3("Iron Age", "Classical Antiquity", "Middle Ages"),
        (0-1500), LIVING,
        "Founded by Zarathustra, state religion of three Persian empires (Achaemenid, Parthian, Sassanid); profoundly influenced Judaism, Christianity, and Islam; living tradition in Iran and India (Parsis)"));

        vec_push(history_vec, history_map_new("Taoist", "Ancient China",
        svec1("Ancient China"), svec5("Zhou Dynasty", "Han Dynasty", "Tang Dynasty", "Song Dynasty", "Ming Dynasty"),
        (0-600), LIVING,
        "From Laozi and Zhuangzi (6th-4th c. BCE) through Celestial Masters and alchemical traditions, deeply woven into Chinese civilization across every dynasty; living tradition"));

        vec_push(history_vec, history_map_new("Polynesian", "Tonga Empire",
        svec2("Tonga Empire", "Hawaiian Kingdom"), svec1("Middle Ages"),
        (0-1000), LIVING,
        "Austronesian spiritual tradition spanning the Pacific triangle -- Hawaii, Aotearoa, Rapa Nui -- with shared cosmology diverging through centuries of island isolation; oral tradition preserved by tohunga"));

        vec_push(history_vec, history_map_new("Slavic", "Byzantine Empire",
        svec1("Byzantine Empire"), svec1("Middle Ages"),
        300, 1200,
        "Pre-Christian Slavic religion reconstructed from chronicles, place names, and folklore; Perun, Veles, and Mokosh displaced by Christianization beginning with Kievan Rus' (988 CE)"));

        vec_push(history_vec, history_map_new("Jain", "Indus Valley",
        svec2("Indus Valley", "Vijayanagara Empire"), svec3("Vedic Period", "Maurya Period", "Gupta Period"),
        (0-800), LIVING,
        "Ancient Indian tradition tracing to Rishabhadeva; historically attested from Parshvanatha (8th c. BCE) and Mahavira (6th c. BCE); major influence on Indian philosophy, art, and non-violence ethics"));

        vec_push(history_vec, history_map_new("Sikh", "Sikh Empire",
        svec1("Sikh Empire"), svec1("Mughal Period"),
        1469, LIVING,
        "Founded by Guru Nanak (1469) in the Punjab during Mughal rule; ten Gurus shaped theology, scripture (Guru Granth Sahib), and martial tradition (Khalsa, 1699); living tradition with 30 million adherents"));

        vec_push(history_vec, history_map_new("Mystic", "Persian Empire",
        svec2("Persian Empire", "Ottoman Empire"), svec2("Middle Ages", "Modern"),
        800, LIVING,
        "Sufi, Christian, Jewish and cross-tradition mystics -- Rumi, Ibn Arabi, Meister Eckhart, Hildegard of Bingen, Teresa of Avila, Isaac Luria, the Baal Shem Tov -- who articulated direct experiential union with the divine across sectarian boundaries; the strand runs from the desert fathers to Thomas Merton in the 20th century"));

        vec_push(history_vec, history_map_new("Comanche", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1700, LIVING,
        "The Comanche (Numunuu) separated from the Eastern Shoshone and moved onto the southern plains in the early 1700s, becoming the dominant horse power of the region; Quanah Parker, the last war chief of the Quahada band, later led the move to reservation life and was a founding figure of the Native American Church"));

        vec_push(history_vec, history_map_new("Northern Paiute", "Great Basin",
        svec1("Great Basin"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "The Northern Paiute (Numu) of the Great Basin; Wovoka received in 1889 the vision that became the Ghost Dance, which spread across the plains within a year and was met with the suppression that ended at Wounded Knee in 1890"));

        vec_push(history_vec, history_map_new("Finnish", "Viking/Norse",
        svec1("Viking/Norse"), svec2("Iron Age", "Middle Ages"),
        (0-1000), LIVING,
        "Finnish and Sami spiritual traditions preserved in the Kalevala (compiled 1835 by Elias Lonnrot from oral tradition) and Sami shamanic practice; Vainamoinen, Ukko, and Tapio reflect Uralic cosmology distinct from but parallel to Norse mythology"));

        vec_push(history_vec, history_map_new("Vodou", "Haiti",
        svec3("Saint-Domingue", "Haiti", "Dahomey"), svec1("Modern"),
        1600, LIVING,
        "Haitian Vodou synthesized West African (primarily Fon and Yoruba) spiritual traditions with Taino and Catholic elements during the colonial period; a living religion of the African diaspora, central to the Haitian Revolution (1791-1804) and Haitian national identity"));

        vec_push(history_vec, history_map_new("Tarot", "Renaissance Italy",
        svec3("Renaissance Italy", "Kingdom of France", "British Empire"), svec2("Renaissance", "Modern"),
        1440, LIVING,
        "The Major Arcana appear as the trump suit of 15th-century Italian tarocchi (Visconti-Sforza decks, c. 1440s Milan); the esoteric reading was developed by Court de Gebelin (1781) and Eliphas Levi, who first mapped the 22 trumps to the 22 Hebrew letters and the Kabbalah, and systematized by the Hermetic Order of the Golden Dawn (1888) into the Tree-of-Life path attributions used here; the Rider-Waite-Smith deck (1909) fixed the modern imagery. A living divinatory and initiatory tradition"));

        vec_push(history_vec, history_map_new("I Ching", "Ancient China",
        svec1("Ancient China"), svec3("Zhou Dynasty", "Han Dynasty", "Song Dynasty"),
        (0-1000), LIVING,
        "The Zhou Yi, oldest of the Chinese classics: its sixty-four hexagram texts were compiled in the Western Zhou (c. 1000-750 BCE) out of a much older milfoil divination practice; the Ten Wings commentaries (Warring States through Han) made it the first of the Five Classics and the shared cosmological root of both Confucian and Taoist thought, and the Song Neo-Confucians (Zhu Xi) reworked it again; still consulted as both oracle and philosophical text"));

        vec_push(history_vec, history_map_new("Inuit", "Inuit Nunangat",
        svec2("Inuit Nunangat", "Greenland"), svec2("Middle Ages", "Modern"),
        1000, LIVING,
        "Thule culture, ancestral to today's Inuit, spread east from Alaska across the Arctic around 1000 CE, carrying the cosmology later recorded by Franz Boas and Knud Rasmussen; a living tradition across Inuit Nunangat, Greenland and Alaska, articulated today as Inuit Qaujimajatuqangit"));

        vec_push(history_vec, history_map_new("Lakota", "Great Plains",
        svec1("Great Plains"), svec2("Middle Ages", "Modern"),
        1500, LIVING,
        "The Lakota, westernmost of the Oceti Sakowin (Seven Council Fires), moved from the woodlands onto the northern plains and, with the horse from the early 1700s, became its dominant people; the cosmology was systematized in print in the early 20th century and is carried in living ceremony -- the Sun Dance and the seven rites of the chanunpa"));

        vec_push(history_vec, history_map_new("Haudenosaunee", "Northeastern Woodlands",
        svec1("Northeastern Woodlands"), svec2("Middle Ages", "Modern"),
        1142, LIVING,
        "The Confederacy of five nations -- Mohawk, Oneida, Onondaga, Cayuga, Seneca -- joined by the Tuscarora in 1722; its founding is dated anywhere from 1142 to the late 1500s depending on the source, and it persists as a governing body. The Sky Woman creation account and the Great Law of Peace have been taught continuously"));

        vec_push(history_vec, history_map_new("Anishinaabe", "Great Lakes",
        svec1("Great Lakes"), svec2("Middle Ages", "Modern"),
        900, LIVING,
        "Ojibwe, Odawa and Potawatomi -- the Council of Three Fires. The migration west from the eastern seaboard to the Great Lakes is recorded in the Seven Fires oral history and on the birchbark scrolls of the Midewiwin as set down by Edward Benton-Banai in *The Mishomis Book*; a living tradition across the Great Lakes and the northern plains"));

        # Aboriginal Australia is carried as one mapping PER PEOPLE, not one
        # continent-wide mapping. There is no shared pantheon and no continental
        # authority; 250+ nations hold distinct languages and distinct Law. Each
        # mapping below lists "Aboriginal Australia" among its civilizations, so
        # traditions_for_civilization("Aboriginal Australia") still gathers them
        # all -- the continent is a place these peoples share, not a tradition
        # any of them belongs to.
        vec_push(history_vec, history_map_new("Kunwinjku", "Arnhem Land",
        svec2("Aboriginal Australia", "Arnhem Land"), svec2("Deep Time", "Modern"),
        (0-50000), LIVING,
        "Kunwinjku is one of six mutually intelligible dialects of Bininj Kunwok, spoken across western Arnhem Land from Kakadu east to the Mann and Liverpool rivers; speakers call themselves Bininj, and the older ethnographic spelling Gunwinggu is disused. Community-governed institutions carry the culture directly: the Bininj Kunwok Regional Language and Culture Centre at Jabiru, Aboriginal-owned Injalak Arts at Gunbalanya, and Warddeken Land Management on the plateau. The escarpment rock-art and bark-painting tradition is continuous rather than revived. The date given is the uncontested floor for the region: Madjedbebe was published in 2017 as occupied 65,000 years ago, but it lies on neighbouring Mirarr country and that figure is contested on stratigraphic grounds where the ~50,000-year floor is not"));

        vec_push(history_vec, history_map_new("Kulin", "Kulin Nation",
        svec2("Aboriginal Australia", "Kulin Nation"), svec2("Deep Time", "Modern"),
        (0-31000), LIVING,
        "The Kulin is a confederacy of five language-owning nations of central Victoria -- Wurundjeri Woi-wurrung, Bunurong, Taungurung, Wadawurrung and Dja Dja Wurrung -- holding country from Port Phillip and Western Port north-west up the Loddon and north-east up the Goulburn. Kulin names an alliance, not a single authority: each nation speaks for itself through its own body, and all five are Registered Aboriginal Parties under Victoria's Aboriginal Heritage Act 2006. Occupation is dated at Murrup Tamboore on Wurundjeri Woi-wurrung country, where a hearth at the Maribyrnong-Dry Creek junction gave a radiocarbon age of about 31,000 years BP"));

        vec_push(history_vec, history_map_new("Gunaikurnai", "Gippsland",
        svec2("Aboriginal Australia", "Gippsland"), svec2("Deep Time", "Modern"),
        (0-25000), LIVING,
        "Gunaikurnai hold Gippsland from Warragul east to the Snowy River and from the Great Divide south to the coast, in five clans -- Brataualung, Brayakaulung, Brabralung, Tatungalung and Krauatungalung. Gunaikurnai Land and Waters Aboriginal Corporation (GLaWAC) is their Registered Aboriginal Party, appointed 2008, and the native title holding body under the Federal Court consent determination of 22 October 2010. Cloggs Cave, on Krauatungalung Country near Buchan, has confirmed occupation by about 25,000 cal BP; re-excavation with GLaWAC established that a practice recorded in Gippsland in the 1880s was already being carried out there at the end of the last ice age"));

        # Four traditions below carried profiles but no mapping until v2.14.0,
        # so context_for_tradition() returned 0 for 19 archetypes. A test now
        # asserts both directions: no mapping without profiles, no tradition
        # without a mapping.
        vec_push(history_vec, history_map_new("Vedic", "Indus Valley",
        svec1("Indus Valley"), svec2("Bronze Age", "Vedic Period"),
        (0-1500), LIVING,
        "The Saptarishi, the seven great rishis to whom the hymns of the Rigveda were revealed -- Kashyapa, Atri, Vashishtha, Vishvamitra, Gautama, Jamadagni and Bharadvaja. Composed orally c. 1500-1200 BCE and transmitted without writing for a millennium; the gotra lineages by which many Hindu families still reckon descent are named for them, so the tradition is living rather than antiquarian"));

        vec_push(history_vec, history_map_new("Canaanite", "Phoenicia",
        svec2("Phoenicia", "Mesopotamia"), svec2("Bronze Age", "Iron Age"),
        (0-2000), 400,
        "The Ugaritic pantheon, recovered from the tablets found at Ras Shamra in 1929 and dating to the 14th-12th centuries BCE; El, Baal, Asherah and Anat are the West Semitic background against which the Hebrew Bible was written, and several survive in it as rivals or as epithets. Ugarit fell c. 1190 BCE but Canaanite religion continued in Phoenician and Punic form until Christianisation"));

        vec_push(history_vec, history_map_new("Etruscan", "Roman Republic",
        svec2("Roman Republic", "Roman Empire"), svec2("Iron Age", "Classical Antiquity"),
        (0-900), 400,
        "The Etruscans of central Italy, whose language is still only partly understood and whose gods Rome absorbed wholesale -- Tinia, Uni and Menrva became the Capitoline Triad. Politically extinguished by Rome by 27 BCE, but the Etrusca disciplina of divination outlasted the civilisation: haruspices were consulted officially until the practice was banned at the end of the 4th century CE"));

        vec_push(history_vec, history_map_new("Solar", "Ancient Egypt",
        svec4("Ancient Egypt", "Maya", "Aztec Empire", "Roman Republic"), svec3("Bronze Age", "Classical Antiquity", "Modern"),
        (0-2900), LIVING,
        "Not a people's tradition but a structural one: the days that do not fit the year. A 365-day count leaves five days over and a quarter-day besides, and four civilisations named the remainder rather than hiding it -- the Egyptian epagomenai (from the Old Kingdom civil calendar, c. 2900 BCE), the Maya Wayeb, the Aztec nemontemi, and the Roman bissextus of the Julian reform of 46 BCE, which survives as the leap day still in use"));

        history_init_done = 1;
    }
    return history_vec;
}

fn mapping_count() { return vec_len(all_mappings()); }

# --- Query functions ---

# Find the mapping for a tradition name. Returns mapping ptr or 0.
fn find_mapping(tradition) {
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (safe_streq(map_tradition(m), tradition) == 1) { return m; }
    }
    return 0;
}

# Get historical context for a tradition. Returns HistoricalContext ptr or 0.
fn context_for_tradition(tradition) {
    var m = find_mapping(tradition);
    if (m == 0) { return 0; }
    var c = xalloc(CTX_SIZE);
    store64(c + CTX_PRIMARY_CIV, map_primary(m));
    store64(c + CTX_CIV_NAMES, map_civs(m));
    store64(c + CTX_ERA_NAMES, map_eras(m));
    store64(c + CTX_START_YEAR, map_start(m));
    store64(c + CTX_END_YEAR, map_end(m));
    store64(c + CTX_NOTE, map_note(m));
    return c;
}

# Get historical context for a profile (by its tradition field).
# Returns 0 for a NULL profile or one whose tradition is unset — every peer
# accessor guards its pointer, and this one did not until 2.14.3.
fn context_for_profile(profile) {
    if (profile == 0) { return 0; }
    var trad = prof_tradition(profile);
    if (trad == 0) { return 0; }
    return context_for_tradition(trad);
}

# List all tradition names that have historical mappings.
fn mapped_traditions() {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        vec_push(result, map_tradition(vec_get(v, i)));
    }
    return result;
}

# Find all traditions associated with a given civilization name.
fn traditions_for_civilization(civ_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var civs = map_civs(m);
        var cn = vec_len(civs);
        for (var j = 0; j < cn; j += 1) {
            if (safe_streq(vec_get(civs, j), civ_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions active during a given year.
fn traditions_active_at(year) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        if (map_start(m) <= year) {
            if (year <= map_end(m)) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}

# Find all traditions associated with a given era name.
fn traditions_for_era(era_name) {
    var result = vec_new();
    var v = all_mappings();
    var n = vec_len(v);
    for (var i = 0; i < n; i += 1) {
        var m = vec_get(v, i);
        var eras = map_eras(m);
        var en = vec_len(eras);
        for (var j = 0; j < en; j += 1) {
            if (safe_streq(vec_get(eras, j), era_name) == 1) {
                vec_push(result, map_tradition(m));
            }
        }
    }
    return result;
}
