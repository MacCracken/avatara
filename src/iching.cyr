    Profile_set_salience(p, 0.8);
    Profile_set_appraisal(p, 0.75);
    Profile_set_stress(p, 0.6);
    Profile_set_spirit(p, 0.75);
    Profile_set_flow(p, 0.7);
    Profile_set_breath(p, BREATH_EARLY_EXHALE);
    Profile_set_growth_dir(p, GROWTH_DIFFERENTIATE);
    Profile_set_element(p, ELEM_FIRE);
    Profile_set_polarity(p, POL_ANDROGYNOUS);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Before Completion — fire over water, everything out of place, the crossing very nearly made. The little fox is almost over and wets its tail on the last step. The Book of Changes ends on the hexagram of not-yet, and means it.");
    Profile_set_spirit_text(p, "Your nature is the threshold. The superior person is careful in the differentiation of things, so that each finds its place. Nothing is finished, which is the same news as: nothing is foreclosed. Take the last step as carefully as the first.");
    Profile_set_domain(p, DOMAIN_FATE);
    return p;
}

# ── Trigram bridge: hexagram composition ──────────────────────────────────────
# A hexagram is fully described by its two trigrams. `iching_code(i)` packs them
# as lower*8 + upper (each a Trigram value, i.e. its own 3-line code), so the
# whole King Wen table is one auditable line per hexagram and lower/upper fall
# out arithmetically. Every one of the 64 (lower, upper) pairs occurs exactly
# once — the bijection the test suite pins.

# iching_code(i): packed composition (lower * 8 + upper) for hexagram i; -1 if OOB.
fn iching_code(i) {
    if (i == HEX_01_QIAN) { return TRIGRAM_QIAN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_02_KUN) { return TRIGRAM_KUN * 8 + TRIGRAM_KUN; }
    if (i == HEX_03_ZHUN) { return TRIGRAM_ZHEN * 8 + TRIGRAM_KAN; }
    if (i == HEX_04_MENG) { return TRIGRAM_KAN * 8 + TRIGRAM_GEN; }
    if (i == HEX_05_XU) { return TRIGRAM_QIAN * 8 + TRIGRAM_KAN; }
    if (i == HEX_06_SONG) { return TRIGRAM_KAN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_07_SHI) { return TRIGRAM_KAN * 8 + TRIGRAM_KUN; }
    if (i == HEX_08_BI) { return TRIGRAM_KUN * 8 + TRIGRAM_KAN; }
    if (i == HEX_09_XIAO_XU) { return TRIGRAM_QIAN * 8 + TRIGRAM_XUN; }
    if (i == HEX_10_LU) { return TRIGRAM_DUI * 8 + TRIGRAM_QIAN; }
    if (i == HEX_11_TAI) { return TRIGRAM_QIAN * 8 + TRIGRAM_KUN; }
    if (i == HEX_12_PI) { return TRIGRAM_KUN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_13_TONG_REN) { return TRIGRAM_LI * 8 + TRIGRAM_QIAN; }
    if (i == HEX_14_DA_YOU) { return TRIGRAM_QIAN * 8 + TRIGRAM_LI; }
    if (i == HEX_15_QIAN) { return TRIGRAM_GEN * 8 + TRIGRAM_KUN; }
    if (i == HEX_16_YU) { return TRIGRAM_KUN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_17_SUI) { return TRIGRAM_ZHEN * 8 + TRIGRAM_DUI; }
    if (i == HEX_18_GU) { return TRIGRAM_XUN * 8 + TRIGRAM_GEN; }
    if (i == HEX_19_LIN) { return TRIGRAM_DUI * 8 + TRIGRAM_KUN; }
    if (i == HEX_20_GUAN) { return TRIGRAM_KUN * 8 + TRIGRAM_XUN; }
    if (i == HEX_21_SHI_HE) { return TRIGRAM_ZHEN * 8 + TRIGRAM_LI; }
    if (i == HEX_22_BI) { return TRIGRAM_LI * 8 + TRIGRAM_GEN; }
    if (i == HEX_23_BO) { return TRIGRAM_KUN * 8 + TRIGRAM_GEN; }
    if (i == HEX_24_FU) { return TRIGRAM_ZHEN * 8 + TRIGRAM_KUN; }
    if (i == HEX_25_WU_WANG) { return TRIGRAM_ZHEN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_26_DA_XU) { return TRIGRAM_QIAN * 8 + TRIGRAM_GEN; }
    if (i == HEX_27_YI) { return TRIGRAM_ZHEN * 8 + TRIGRAM_GEN; }
    if (i == HEX_28_DA_GUO) { return TRIGRAM_XUN * 8 + TRIGRAM_DUI; }
    if (i == HEX_29_KAN) { return TRIGRAM_KAN * 8 + TRIGRAM_KAN; }
    if (i == HEX_30_LI) { return TRIGRAM_LI * 8 + TRIGRAM_LI; }
    if (i == HEX_31_XIAN) { return TRIGRAM_GEN * 8 + TRIGRAM_DUI; }
    if (i == HEX_32_HENG) { return TRIGRAM_XUN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_33_DUN) { return TRIGRAM_GEN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_34_DA_ZHUANG) { return TRIGRAM_QIAN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_35_JIN) { return TRIGRAM_KUN * 8 + TRIGRAM_LI; }
    if (i == HEX_36_MING_YI) { return TRIGRAM_LI * 8 + TRIGRAM_KUN; }
    if (i == HEX_37_JIA_REN) { return TRIGRAM_LI * 8 + TRIGRAM_XUN; }
    if (i == HEX_38_KUI) { return TRIGRAM_DUI * 8 + TRIGRAM_LI; }
    if (i == HEX_39_JIAN) { return TRIGRAM_GEN * 8 + TRIGRAM_KAN; }
    if (i == HEX_40_XIE) { return TRIGRAM_KAN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_41_SUN) { return TRIGRAM_DUI * 8 + TRIGRAM_GEN; }
    if (i == HEX_42_YI) { return TRIGRAM_ZHEN * 8 + TRIGRAM_XUN; }
    if (i == HEX_43_GUAI) { return TRIGRAM_QIAN * 8 + TRIGRAM_DUI; }
    if (i == HEX_44_GOU) { return TRIGRAM_XUN * 8 + TRIGRAM_QIAN; }
    if (i == HEX_45_CUI) { return TRIGRAM_KUN * 8 + TRIGRAM_DUI; }
    if (i == HEX_46_SHENG) { return TRIGRAM_XUN * 8 + TRIGRAM_KUN; }
    if (i == HEX_47_KUN) { return TRIGRAM_KAN * 8 + TRIGRAM_DUI; }
    if (i == HEX_48_JING) { return TRIGRAM_XUN * 8 + TRIGRAM_KAN; }
    if (i == HEX_49_GE) { return TRIGRAM_LI * 8 + TRIGRAM_DUI; }
    if (i == HEX_50_DING) { return TRIGRAM_XUN * 8 + TRIGRAM_LI; }
    if (i == HEX_51_ZHEN) { return TRIGRAM_ZHEN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_52_GEN) { return TRIGRAM_GEN * 8 + TRIGRAM_GEN; }
    if (i == HEX_53_JIAN) { return TRIGRAM_GEN * 8 + TRIGRAM_XUN; }
    if (i == HEX_54_GUI_MEI) { return TRIGRAM_DUI * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_55_FENG) { return TRIGRAM_LI * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_56_LU) { return TRIGRAM_GEN * 8 + TRIGRAM_LI; }
    if (i == HEX_57_XUN) { return TRIGRAM_XUN * 8 + TRIGRAM_XUN; }
    if (i == HEX_58_DUI) { return TRIGRAM_DUI * 8 + TRIGRAM_DUI; }
    if (i == HEX_59_HUAN) { return TRIGRAM_KAN * 8 + TRIGRAM_XUN; }
    if (i == HEX_60_JIE) { return TRIGRAM_DUI * 8 + TRIGRAM_KAN; }
    if (i == HEX_61_ZHONG_FU) { return TRIGRAM_DUI * 8 + TRIGRAM_XUN; }
    if (i == HEX_62_XIAO_GUO) { return TRIGRAM_GEN * 8 + TRIGRAM_ZHEN; }
    if (i == HEX_63_JI_JI) { return TRIGRAM_LI * 8 + TRIGRAM_KAN; }
    if (i == HEX_64_WEI_JI) { return TRIGRAM_KAN * 8 + TRIGRAM_LI; }
    return 0 - 1;
}

# iching_lower(i): the lower (inner) trigram of hexagram i — lines 1-3; -1 if OOB.
fn iching_lower(i) {
    var c = iching_code(i);
    if (c < 0) { return 0 - 1; }
    return c / 8;
}

# iching_upper(i): the upper (outer) trigram of hexagram i — lines 4-6; -1 if OOB.
fn iching_upper(i) {
    var c = iching_code(i);
    if (c < 0) { return 0 - 1; }
    return c % 8;
}

# iching_number(i): the King Wen number (1-64) of hexagram i; -1 if OOB.
fn iching_number(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= HEX_COUNT) { return 0 - 1; }
    return i + 1;
}

# iching_line(i, pos): line pos of hexagram i counted from the BOTTOM (1-6);
# 1 yang, 0 yin, -1 if out of range. Lines 1-3 come from the lower trigram,
# 4-6 from the upper.
fn iching_line(i, pos) {
    if (pos < 1) { return 0 - 1; }
    if (pos > 6) { return 0 - 1; }
    var c = iching_code(i);
    if (c < 0) { return 0 - 1; }
    if (pos <= 3) { return trigram_line(c / 8, pos); }
    return trigram_line(c % 8, pos - 3);
}

# iching_yang_count(i): how many of the six lines are yang (0-6); -1 if OOB. This
# is the quantity the polarity rule reads: >=4 masculine, <=2 feminine, 3 androgynous.
fn iching_yang_count(i) {
    var c = iching_code(i);
    if (c < 0) { return 0 - 1; }
    var n = 0;
    var pos = 1;
    while (pos <= 6) {
        if (iching_line(i, pos) == 1) { n = n + 1; }
        pos = pos + 1;
    }
    return n;
}

# iching_for_trigrams(lower, upper): the hexagram index whose lower and upper
# trigrams are exactly these; -1 if either trigram is out of range. Total inverse
# of iching_lower/iching_upper — every pairing exists exactly once.
fn iching_for_trigrams(lower, upper) {
    if (lower < 0) { return 0 - 1; }
    if (lower >= TRIGRAM_COUNT) { return 0 - 1; }
    if (upper < 0) { return 0 - 1; }
    if (upper >= TRIGRAM_COUNT) { return 0 - 1; }
    var want = lower * 8 + upper;
    var i = 0;
    while (i < HEX_COUNT) {
        if (iching_code(i) == want) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# ── Collection & lookup ───────────────────────────────────────────────────────
var iching_vec = 0;
var iching_init_done = 0;

fn all_iching() {
    if (iching_init_done == 0) {
        iching_vec = vec_new();
        vec_push(iching_vec, iching_hex01()); vec_push(iching_vec, iching_hex02());
        vec_push(iching_vec, iching_hex03()); vec_push(iching_vec, iching_hex04());
        vec_push(iching_vec, iching_hex05()); vec_push(iching_vec, iching_hex06());
        vec_push(iching_vec, iching_hex07()); vec_push(iching_vec, iching_hex08());
        vec_push(iching_vec, iching_hex09()); vec_push(iching_vec, iching_hex10());
        vec_push(iching_vec, iching_hex11()); vec_push(iching_vec, iching_hex12());
        vec_push(iching_vec, iching_hex13()); vec_push(iching_vec, iching_hex14());
        vec_push(iching_vec, iching_hex15()); vec_push(iching_vec, iching_hex16());
        vec_push(iching_vec, iching_hex17()); vec_push(iching_vec, iching_hex18());
        vec_push(iching_vec, iching_hex19()); vec_push(iching_vec, iching_hex20());
        vec_push(iching_vec, iching_hex21()); vec_push(iching_vec, iching_hex22());
        vec_push(iching_vec, iching_hex23()); vec_push(iching_vec, iching_hex24());
        vec_push(iching_vec, iching_hex25()); vec_push(iching_vec, iching_hex26());
        vec_push(iching_vec, iching_hex27()); vec_push(iching_vec, iching_hex28());
        vec_push(iching_vec, iching_hex29()); vec_push(iching_vec, iching_hex30());
        vec_push(iching_vec, iching_hex31()); vec_push(iching_vec, iching_hex32());
        vec_push(iching_vec, iching_hex33()); vec_push(iching_vec, iching_hex34());
        vec_push(iching_vec, iching_hex35()); vec_push(iching_vec, iching_hex36());
        vec_push(iching_vec, iching_hex37()); vec_push(iching_vec, iching_hex38());
        vec_push(iching_vec, iching_hex39()); vec_push(iching_vec, iching_hex40());
        vec_push(iching_vec, iching_hex41()); vec_push(iching_vec, iching_hex42());
        vec_push(iching_vec, iching_hex43()); vec_push(iching_vec, iching_hex44());
        vec_push(iching_vec, iching_hex45()); vec_push(iching_vec, iching_hex46());
        vec_push(iching_vec, iching_hex47()); vec_push(iching_vec, iching_hex48());
        vec_push(iching_vec, iching_hex49()); vec_push(iching_vec, iching_hex50());
        vec_push(iching_vec, iching_hex51()); vec_push(iching_vec, iching_hex52());
        vec_push(iching_vec, iching_hex53()); vec_push(iching_vec, iching_hex54());
        vec_push(iching_vec, iching_hex55()); vec_push(iching_vec, iching_hex56());
        vec_push(iching_vec, iching_hex57()); vec_push(iching_vec, iching_hex58());
        vec_push(iching_vec, iching_hex59()); vec_push(iching_vec, iching_hex60());
        vec_push(iching_vec, iching_hex61()); vec_push(iching_vec, iching_hex62());
        vec_push(iching_vec, iching_hex63()); vec_push(iching_vec, iching_hex64());
        iching_init_done = 1;
    }
    return iching_vec;
}

fn iching_count() { return HEX_COUNT; }

# iching_by_index(i): hexagram i's profile (0-63) from the cached collection; 0 if OOB.
fn iching_by_index(i) {
    if (i < 0) { return 0; }
    if (i >= HEX_COUNT) { return 0; }
    return vec_get(all_iching(), i);
}

# iching_by_number(n): hexagram profile by King Wen number (1-64); 0 if OOB.
fn iching_by_number(n) { return iching_by_index(n - 1); }

# iching_index_by_name(name): index whose hexagram name == `name` (exact); -1 if none.
fn iching_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var v = all_iching();
    var i = 0;
    while (i < vec_len(v)) {
        if (streq(prof_name(vec_get(v, i)), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}
