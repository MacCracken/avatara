    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Opposition — fire going up, water going down, sharing a house and no direction. You see the other clearly and cannot stand where they stand. Neither of you is simply wrong.");
    Profile_set_spirit_text(p, "Your nature is productive difference. Amid all fellowship the superior person retains their individuality; in small matters, good fortune. Do not force the union — heaven and earth are opposite, and their work is the same work.");
    Profile_set_domain(p, DOMAIN_CHAOS);
    return p;
}

