    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Splitting Apart — the mountain resting on earth that is being carried out from under it, one bright line left at the top. What is falling has been falling for a long time.");
    Profile_set_spirit_text(p, "Your nature is the season of collapse. It is not the hour to advance; it is the hour to be generous below and stand still above. Nothing is destroyed forever — the last fruit is never eaten, and holds the next seed.");
    Profile_set_domain(p, DOMAIN_CHAOS);
    return p;
}

