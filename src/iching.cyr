    Profile_set_spirit_text(p, "Your nature is fertile communion. Peace is not the absence of movement but its perfect exchange. Tend it while it holds — no plain stays level forever, and the wise use good years to prepare for the turn.");
    Profile_set_domain(p, DOMAIN_PROSPERITY);
    return p;
}

