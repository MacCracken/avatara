    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are Treading — your foot is on the tiger's tail and the tiger does not bite. Not because you are strong. Because you are exact, and courteous, and unhurried in a place that punishes none of those.");
    Profile_set_spirit_text(p, "Your nature is conduct under danger. Know what is above and what is below and keep to your own footing. Manners are not decoration here; they are how one walks past teeth.");
    Profile_set_domain(p, DOMAIN_ORDER);
    return p;
}

