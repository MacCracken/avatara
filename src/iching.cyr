    Profile_set_growth_dir(p, GROWTH_PRESERVE);
    Profile_set_element(p, ELEM_AIR);
    Profile_set_polarity(p, POL_MASCULINE);
    Profile_set_tier(p, TIER_COSMIC);
    Profile_set_soul(p, "You are the Family — wind born out of the household fire and going out from it over everything. What is ordered at the hearth orders the state; the smallest circle sets the shape of the largest.");
    Profile_set_spirit_text(p, "Your nature is influence that begins at home. Let words have substance and conduct have constancy. Correct the family and the world corrects itself, because there is nowhere else the world learns it from.");
    Profile_set_domain(p, DOMAIN_HEARTH);
    return p;
}

# ── 38 · Kui — Opposition ─────────────────────────────────────────────────────
# Fire over Lake (110101). Fire climbs, the lake seeps down: two natures under
