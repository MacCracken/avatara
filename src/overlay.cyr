# overlay.cyr -- Archetype overlays: cross-cutting typologies read OFF the profile.
#
# The first layer in this library that sits ON TOP of the archetypes rather than
# beside them. A tradition module answers "who is this?"; an overlay answers
# "what shape is this, in a system that was not built for it?" — what Enneagram
# type does Thor read as, which Jungian role is Iktomi playing. Nothing here is
# authored per archetype and nothing is stored: every value is derived from the
# profile's own trait and emphasis weights, the same way `aspect.cyr` derives
# roles. Profiles are unchanged, the 320-byte layout is untouched, and the
# registry does not know these exist — overlays are not archetypes and are not
# counted as such.
#
# WHAT AN OVERLAY SCORE IS, AND IS NOT. `profile_enneagram_score(p, i)` says how
# strongly p's personality vector reads as type i on this library's mapping. It
# is a projection of one system onto another, not a diagnosis and not a claim
# that the tradition itself recognises the category — the Enneagram is a 20th-
# century typology and Jung's archetypes are 20th-century psychology; neither
# was in the room when the Dagda or Sedna were described. Consumers wanting the
# archetype's own self-understanding should read `domain`, `soul` and `spirit`.
#
# TWO OVERLAY FAMILIES, both index-stable so the API can grow without breaking:
#   Enneagram  — nine types, three centres, wings.
#   Jungian    — Hero, Shadow, Anima/Animus, Self, Trickster.
#
# THE SHADOW IS TWO DIFFERENT THINGS and the distinction matters. The Jungian
# SHADOW overlay scores how much a profile already *expresses* shadow qualities —
# the disowned, cold, adversarial register. `shadow(p)` in `shadow.cyr`
# CONSTRUCTS a different profile: p's inversion. `jungian_shadow_form(p)` is the
# composition point between the two, and returns the constructed inversion.
# Scoring high on the SHADOW overlay is a property of p; shadow(p) is a
# different archetype.
#
# Sources: the Enneagram type names, centres and wing structure follow the
# standard Riso-Hudson presentation; the Jungian set follows Jung's *Archetypes
# and the Collective Unconscious* and *Aion*.

# --- The nine Enneagram types -------------------------------------------------
enum Enneagram {
    ENN_REFORMER = 0;       # 1
    ENN_HELPER = 1;         # 2
    ENN_ACHIEVER = 2;       # 3
    ENN_INDIVIDUALIST = 3;  # 4
    ENN_INVESTIGATOR = 4;   # 5
    ENN_LOYALIST = 5;       # 6
    ENN_ENTHUSIAST = 6;     # 7
    ENN_CHALLENGER = 7;     # 8
    ENN_PEACEMAKER = 8;     # 9
    ENN_COUNT = 9;
}

# The three centres of intelligence. Gut/body: 8, 9, 1. Heart: 2, 3, 4.
# Head: 5, 6, 7. Each centre holds exactly three consecutive types.
enum EnneagramCentre {
    CENTRE_GUT = 0;
    CENTRE_HEART = 1;
    CENTRE_HEAD = 2;
    CENTRE_COUNT = 3;
}

# --- The Jungian set ----------------------------------------------------------
enum Jungian {
    JUNG_HERO = 0;
    JUNG_SHADOW = 1;
    JUNG_ANIMA = 2;
    JUNG_SELF = 3;
    JUNG_TRICKSTER = 4;
    JUNG_COUNT = 5;
}

# --- Small f64 helpers (weights are IEEE 754 bit patterns) --------------------

fn ov_inv(v) { return f64_sub(1.0, v); }

fn ov_mean2(a, b) { return f64_div(f64_add(a, b), 2.0); }

fn ov_mean3(a, b, c) { return f64_div(f64_add(f64_add(a, b), c), 3.0); }

# --- Enneagram: naming --------------------------------------------------------

# enneagram_number(i): the conventional type number 1-9; -1 if out of range.
fn enneagram_number(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    return i + 1;
}

# enneagram_name(i): short lowercase handle, for selection by a consumer.
fn enneagram_name(i) {
    if (i == ENN_REFORMER) { return "reformer"; }
    if (i == ENN_HELPER) { return "helper"; }
    if (i == ENN_ACHIEVER) { return "achiever"; }
    if (i == ENN_INDIVIDUALIST) { return "individualist"; }
    if (i == ENN_INVESTIGATOR) { return "investigator"; }
    if (i == ENN_LOYALIST) { return "loyalist"; }
    if (i == ENN_ENTHUSIAST) { return "enthusiast"; }
    if (i == ENN_CHALLENGER) { return "challenger"; }
    if (i == ENN_PEACEMAKER) { return "peacemaker"; }
    return "unknown";
}

# enneagram_title(i): the type's display title.
fn enneagram_title(i) {
    if (i == ENN_REFORMER) { return "The Reformer"; }
    if (i == ENN_HELPER) { return "The Helper"; }
    if (i == ENN_ACHIEVER) { return "The Achiever"; }
    if (i == ENN_INDIVIDUALIST) { return "The Individualist"; }
    if (i == ENN_INVESTIGATOR) { return "The Investigator"; }
    if (i == ENN_LOYALIST) { return "The Loyalist"; }
    if (i == ENN_ENTHUSIAST) { return "The Enthusiast"; }
    if (i == ENN_CHALLENGER) { return "The Challenger"; }
    if (i == ENN_PEACEMAKER) { return "The Peacemaker"; }
    return "Unknown";
}

# enneagram_core_desire(i): what the type is moving toward.
fn enneagram_core_desire(i) {
    if (i == ENN_REFORMER) { return "to be good, to have integrity, to be beyond reproach"; }
    if (i == ENN_HELPER) { return "to be loved, and to be needed for what one gives"; }
    if (i == ENN_ACHIEVER) { return "to be valuable, and to be seen to be"; }
    if (i == ENN_INDIVIDUALIST) { return "to be authentic, and to matter as oneself"; }
    if (i == ENN_INVESTIGATOR) { return "to understand, and to be competent enough to be left alone"; }
    if (i == ENN_LOYALIST) { return "security, and something worth being loyal to"; }
    if (i == ENN_ENTHUSIAST) { return "to be satisfied, and never to be trapped"; }
    if (i == ENN_CHALLENGER) { return "to protect oneself, and to be in control of one's own life"; }
    if (i == ENN_PEACEMAKER) { return "inner and outer peace, and connection without friction"; }
    return "";
}

# enneagram_core_fear(i): what the type is moving away from.
fn enneagram_core_fear(i) {
    if (i == ENN_REFORMER) { return "being corrupt, defective, or in the wrong"; }
    if (i == ENN_HELPER) { return "being unwanted, or loved only conditionally"; }
    if (i == ENN_ACHIEVER) { return "being worthless apart from achievement"; }
    if (i == ENN_INDIVIDUALIST) { return "having no identity of one's own, or no significance"; }
    if (i == ENN_INVESTIGATOR) { return "being useless, overwhelmed, or depleted by others"; }
    if (i == ENN_LOYALIST) { return "being without support or guidance"; }
    if (i == ENN_ENTHUSIAST) { return "being trapped in pain or deprivation"; }
    if (i == ENN_CHALLENGER) { return "being harmed, controlled, or at another's mercy"; }
    if (i == ENN_PEACEMAKER) { return "loss and separation, and the conflict that risks them"; }
    return "";
}

# enneagram_centre(i): the centre of intelligence type i belongs to; -1 if OOB.
fn enneagram_centre(i) {
    if (i == ENN_CHALLENGER) { return CENTRE_GUT; }
    if (i == ENN_PEACEMAKER) { return CENTRE_GUT; }
    if (i == ENN_REFORMER) { return CENTRE_GUT; }
    if (i == ENN_HELPER) { return CENTRE_HEART; }
    if (i == ENN_ACHIEVER) { return CENTRE_HEART; }
    if (i == ENN_INDIVIDUALIST) { return CENTRE_HEART; }
    if (i == ENN_INVESTIGATOR) { return CENTRE_HEAD; }
    if (i == ENN_LOYALIST) { return CENTRE_HEAD; }
    if (i == ENN_ENTHUSIAST) { return CENTRE_HEAD; }
    return 0 - 1;
}

# centre_name(c): the centre's name; "" if out of range.
fn centre_name(c) {
    if (c == CENTRE_GUT) { return "gut"; }
    if (c == CENTRE_HEART) { return "heart"; }
    if (c == CENTRE_HEAD) { return "head"; }
    return "";
}

# centre_emotion(c): the emotion the centre is organised around.
fn centre_emotion(c) {
    if (c == CENTRE_GUT) { return "anger"; }
    if (c == CENTRE_HEART) { return "shame"; }
    if (c == CENTRE_HEAD) { return "fear"; }
    return "";
}

# enneagram_wing_low(i) / _high(i): the adjacent types on the circle. The nine
# types are a ring, so 1's low wing is 9 and 9's high wing is 1. -1 if OOB.
fn enneagram_wing_low(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    if (i == 0) { return ENN_COUNT - 1; }
    return i - 1;
}

fn enneagram_wing_high(i) {
    if (i < 0) { return 0 - 1; }
    if (i >= ENN_COUNT) { return 0 - 1; }
    if (i == ENN_COUNT - 1) { return 0; }
    return i + 1;
}

fn enneagram_count() { return ENN_COUNT; }

fn centre_count() { return CENTRE_COUNT; }

# enneagram_index_by_name(name): index whose enneagram_name == name; -1 if none.
fn enneagram_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < ENN_COUNT) {
        if (streq(enneagram_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Enneagram: derivation ----------------------------------------------------
# Each type reads three profile fields. The mapping is this library's own and is
# documented here rather than hidden: it is a defensible reading, not the only
# possible one. Inverted contributions use ov_inv so that "withdrawn" scores on
# low verbosity rather than needing a separate axis.

# profile_enneagram_score(p, i): how strongly p reads as type i (0.0-1.0).
# 0.0 for a null profile or an out-of-range type.
fn profile_enneagram_score(p, i) {
    if (p == 0) { return 0.0; }
    # 1 — principled, self-controlled, critical of what falls short
    if (i == ENN_REFORMER) {
        return ov_mean3(load64(p + PROF_PRECISION), load64(p + PROF_REGULATION), load64(p + PROF_SKEPTICISM));
    }
    # 2 — warm, attentive to others, defined by being needed
    if (i == ENN_HELPER) {
        return ov_mean3(load64(p + PROF_EMPATHY), load64(p + PROF_WARMTH), load64(p + PROF_RELATIONSHIP));
    }
    # 3 — driven, visible, organised around performance
    if (i == ENN_ACHIEVER) {
        return ov_mean3(load64(p + PROF_CONFIDENCE), load64(p + PROF_ENERGY), load64(p + PROF_SALIENCE));
    }
    # 4 — singular, inward, aesthetically self-defining
    if (i == ENN_INDIVIDUALIST) {
        return ov_mean3(load64(p + PROF_CREATIVITY), load64(p + PROF_INTUITION), load64(p + PROF_AUTONOMY));
    }
    # 5 — curious, analytical, withdrawn (low verbosity carries the withdrawal)
    if (i == ENN_INVESTIGATOR) {
        return ov_mean3(load64(p + PROF_CURIOSITY), load64(p + PROF_REASONING), ov_inv(load64(p + PROF_VERBOSITY)));
    }
    # 6 — vigilant, committed, alert to threat
    if (i == ENN_LOYALIST) {
        return ov_mean3(load64(p + PROF_SKEPTICISM), load64(p + PROF_STRESS), load64(p + PROF_RELATIONSHIP));
    }
    # 7 — buoyant, quick, appetite for the next thing
    if (i == ENN_ENTHUSIAST) {
        return ov_mean3(load64(p + PROF_HUMOR), load64(p + PROF_MOOD), load64(p + PROF_ENERGY));
    }
    # 8 — direct, self-authoring, unwilling to be handled
    if (i == ENN_CHALLENGER) {
        return ov_mean3(load64(p + PROF_DIRECTNESS), load64(p + PROF_COURAGE), load64(p + PROF_AUTONOMY));
    }
    # 9 — even, accommodating, conflict-averse (low directness carries the aversion)
    if (i == ENN_PEACEMAKER) {
        return ov_mean3(load64(p + PROF_PATIENCE), load64(p + PROF_EQ), ov_inv(load64(p + PROF_DIRECTNESS)));
    }
    return 0.0;
}

# profile_enneagram_type(p): p's dominant type. Ties resolve to the lowest index
# (stable); 0 for a null profile, matching profile_dominant_aspect's convention.
fn profile_enneagram_type(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_enneagram_score(p, 0);
    var i = 1;
    while (i < ENN_COUNT) {
        var w = profile_enneagram_score(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}

# profile_enneagram_wing(p): whichever adjacent type scores higher for p — the
# wing on its dominant type. Ties resolve to the low wing.
fn profile_enneagram_wing(p) {
    if (p == 0) { return 0 - 1; }
    var t = profile_enneagram_type(p);
    var lo = enneagram_wing_low(t);
    var hi = enneagram_wing_high(t);
    if (f64_gt(profile_enneagram_score(p, hi), profile_enneagram_score(p, lo)) == 1) { return hi; }
    return lo;
}

# profile_enneagram_centre(p): the centre p's dominant type belongs to.
fn profile_enneagram_centre(p) {
    if (p == 0) { return 0 - 1; }
    return enneagram_centre(profile_enneagram_type(p));
}

# --- Jungian: naming ----------------------------------------------------------

fn jungian_name(i) {
    if (i == JUNG_HERO) { return "hero"; }
    if (i == JUNG_SHADOW) { return "shadow"; }
    if (i == JUNG_ANIMA) { return "anima"; }
    if (i == JUNG_SELF) { return "self"; }
    if (i == JUNG_TRICKSTER) { return "trickster"; }
    return "unknown";
}

fn jungian_title(i) {
    if (i == JUNG_HERO) { return "The Hero"; }
    if (i == JUNG_SHADOW) { return "The Shadow"; }
    if (i == JUNG_ANIMA) { return "The Anima/Animus"; }
    if (i == JUNG_SELF) { return "The Self"; }
    if (i == JUNG_TRICKSTER) { return "The Trickster"; }
    return "Unknown";
}

fn jungian_desc(i) {
    if (i == JUNG_HERO) { return "the ego that goes out to meet the task — courage spent on something outside itself"; }
    if (i == JUNG_SHADOW) { return "what the personality has disowned; not the evil in a figure but the part it will not claim"; }
    if (i == JUNG_ANIMA) { return "the contrasexual soul-image — the inward, relational, feeling-toned counterpart that mediates the unconscious"; }
    if (i == JUNG_SELF) { return "the organising whole, larger than the ego; the centre a personality is circling rather than occupying"; }
    if (i == JUNG_TRICKSTER) { return "the disruptive intelligence that breaks form to keep it alive — comic, amoral, and necessary"; }
    return "";
}

fn jungian_count() { return JUNG_COUNT; }

# jungian_index_by_name(name): index whose jungian_name == name; -1 if none.
fn jungian_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < JUNG_COUNT) {
        if (streq(jungian_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# --- Jungian: derivation ------------------------------------------------------

# profile_jungian_score(p, i): how strongly p expresses role i (0.0-1.0).
fn profile_jungian_score(p, i) {
    if (p == 0) { return 0.0; }
    # Hero — courage turned outward, with the confidence and momentum to spend it
    if (i == JUNG_HERO) {
        return ov_mean3(load64(p + PROF_COURAGE), load64(p + PROF_CONFIDENCE), load64(p + PROF_GROWTH));
    }
    # Shadow — the cold, withheld, adversarial register; scored on what is ABSENT
    if (i == JUNG_SHADOW) {
        return ov_mean3(ov_inv(load64(p + PROF_WARMTH)), ov_inv(load64(p + PROF_EMPATHY)), load64(p + PROF_SKEPTICISM));
    }
    # Anima/Animus — the inward, feeling-toned, relational mediator
    if (i == JUNG_ANIMA) {
        return ov_mean3(load64(p + PROF_INTUITION), load64(p + PROF_EQ), load64(p + PROF_RELATIONSHIP));
    }
    # Self — the integrating whole: spiritual reach held with regulation
    if (i == JUNG_SELF) {
        return ov_mean3(load64(p + PROF_SPIRIT), load64(p + PROF_EQ), load64(p + PROF_REGULATION));
    }
    # Trickster — wit and invention refusing to be formal about it
    if (i == JUNG_TRICKSTER) {
        return ov_mean3(load64(p + PROF_HUMOR), load64(p + PROF_CREATIVITY), ov_inv(load64(p + PROF_FORMALITY)));
    }
    return 0.0;
}

# profile_jungian_role(p): p's dominant Jungian role. Ties to the lowest index;
# 0 for a null profile.
fn profile_jungian_role(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_jungian_score(p, 0);
    var i = 1;
    while (i < JUNG_COUNT) {
        var w = profile_jungian_score(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}

# jungian_shadow_form(p): the composition point with `shadow.cyr`. The SHADOW
# overlay above scores how much p already expresses shadow qualities; THIS
# returns the constructed inversion of p — a different archetype, named
# "Shadow of <p>". 0 for a null profile.
fn jungian_shadow_form(p) {
    if (p == 0) { return 0; }
    return shadow(p);
}
