# aspect.cyr -- Role aspects: derive an archetype's ROLES from its personality vector.
#
# An archetype (Profile) is a personality — 15 trait weights + 14 module emphases + soul/spirit + a domain.
# It carries no single "role"; a role is a FACET (aspect) of that personality. This module derives a small,
# UNIVERSAL set of aspects from the trait weights: each aspect maps one salient trait to a role label
# (precision -> the Measurer, empathy -> the Mediator, ...). Every archetype expresses all of them to some
# degree (its weight for each trait); its DOMINANT aspect (highest-weighted) is its default role, and a
# consumer can enumerate or select any aspect to lean into. Pure derivation over the Profile — no
# per-archetype authoring, no state.
#
# The set is deliberately small (a good base, not exhaustive). A consumer may additionally OVERRIDE the role
# with its own label (thoth's `/role <custom>` makes anyone "the Librarian" / "Keeper of Symbols" / ...);
# that user preference is the consumer's concern, not archetype semantics, and lives there. The set can grow
# or gain per-archetype overrides later without breaking this index-stable API.

enum AspectSet {
    ASPECT_COUNT = 8;
}

# aspect_trait_offset(i): the Profile trait offset aspect i derives from (PROF_* from types.cyr); -1 if OOB.
fn aspect_trait_offset(i) {
    if (i == 0) { return PROF_CURIOSITY; }
    if (i == 1) { return PROF_CREATIVITY; }
    if (i == 2) { return PROF_PRECISION; }
    if (i == 3) { return PROF_SKEPTICISM; }
    if (i == 4) { return PROF_PEDAGOGY; }
    if (i == 5) { return PROF_EMPATHY; }
    if (i == 6) { return PROF_COURAGE; }
    if (i == 7) { return PROF_AUTONOMY; }
    return 0 - 1;
}

# aspect_name(i): the aspect's short lowercase id (a selectable handle; mirrors a trait dimension).
fn aspect_name(i) {
    if (i == 0) { return "seeker"; }
    if (i == 1) { return "maker"; }
    if (i == 2) { return "measurer"; }
    if (i == 3) { return "critic"; }
    if (i == 4) { return "teacher"; }
    if (i == 5) { return "mediator"; }
    if (i == 6) { return "champion"; }
    if (i == 7) { return "sovereign"; }
    return "unknown";
}

# aspect_role(i): the role label the aspect confers (the persona's framing / how it presents).
fn aspect_role(i) {
    if (i == 0) { return "the Seeker"; }
    if (i == 1) { return "the Maker"; }
    if (i == 2) { return "the Measurer"; }
    if (i == 3) { return "the Critic"; }
    if (i == 4) { return "the Teacher"; }
    if (i == 5) { return "the Mediator"; }
    if (i == 6) { return "the Champion"; }
    if (i == 7) { return "the Sovereign"; }
    return "the Adept";
}

# aspect_count(): number of derived aspects.
fn aspect_count() { return ASPECT_COUNT; }

# aspect_index_by_name(name): the index whose aspect_name == `name` (exact match), or -1. Consumers that
# accept free-form user input normalize case before calling.
fn aspect_index_by_name(name) {
    if (name == 0) { return 0 - 1; }
    var i = 0;
    while (i < ASPECT_COUNT) {
        if (safe_streq(aspect_name(i), name) == 1) { return i; }
        i = i + 1;
    }
    return 0 - 1;
}

# profile_aspect_weight(p, i): archetype p's f64 trait weight for aspect i (0.0..1.0); 0.0 for a bad index.
fn profile_aspect_weight(p, i) {
    if (p == 0) { return 0.0; }
    var off = aspect_trait_offset(i);
    if (off < 0) { return 0.0; }
    return load64(p + off);
}

# profile_dominant_aspect(p): the index of p's highest-weighted aspect — its DEFAULT role. Ties resolve to
# the lowest index (stable). Returns 0 for a null profile.
fn profile_dominant_aspect(p) {
    if (p == 0) { return 0; }
    var best = 0;
    var bestw = profile_aspect_weight(p, 0);
    var i = 1;
    while (i < ASPECT_COUNT) {
        var w = profile_aspect_weight(p, i);
        if (f64_gt(w, bestw) == 1) { best = i; bestw = w; }
        i = i + 1;
    }
    return best;
}
